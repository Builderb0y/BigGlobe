{
	"type": "bigglobe:root",
	"state": "'minecraft:air'",
	"children": [
		"bigglobe:obelisks/flat_stone",
		"bigglobe:obelisks/obelisk_stone",
		"bigglobe:obelisks/glowstone"
	],
	"after_children": [
		"int startY = -64",
		"for (int endY = startY, (endY := getTopOfSegment(startY)) < 320, startY = endY:",
			"if (getBlockState(startY) ==. 'minecraft:stone' && getBlockState(endY) ==. 'minecraft:air':",
				"if (int*(depth := int(4.0I - 4.0I * `bigglobe:obelisks/terrain_bias`(endY))) > 0:",
					"setBlockStates(max(startY, endY - depth), endY, 'minecraft:dirt')",
					"setBlockState(endY - 1, 'minecraft:grass_block[snowy=false]')",
				")",
			")",
		")"
	]
}