{
	"type": "column_value",
	"script": [
		"double parabolaSDFSquared(double*(transformedX, transformedY, transformedZ):",
			"transformedX = abs(transformedX)",
			"double*(",
				"poly               = ((-16.0L * transformedY + 24.0L) * transformedY - 12.0L) * transformedY + 27.0L * transformedX * transformedX + 2.0L",
				"firstRadicalCommon = sqrt(abs(poly) / (27.0L * 16.0L))",
				"firstRadicalReal   = transformedX * 0.25 + (poly >= 0.0L ? firstRadicalCommon : 0.0L)",
				"firstRadicalImag   = poly < 0.0L ? firstRadicalCommon : 0.0L",
				"thirdAngle         = fastAtan(firstRadicalImag / firstRadicalReal) / 3.0L",
				"thirdRadius        = cbrt(sqrt(firstRadicalReal ^ 2 + firstRadicalImag ^ 2))",
				"thirdReal          = fastCos(thirdAngle) * thirdRadius",
				"conjugateProduct   = (2.0L * transformedY - 1.0L) / (6.0L * thirdRadius ^ 2)",
				"closestX           = thirdReal * conjugateProduct + thirdReal",
				"closestY           = closestX ^ 2",
				"distance          := (transformedX - closestX) ^ 2 + (transformedY - closestY) ^ 2 + transformedZ ^ 2",
			")",
		")",
		"int*(centerCellX = x >> 8, centerCellZ = z >> 8)",
		"for (int*(cellOffsetZ, cellOffsetX) in range[-1, 1]:",
			"int*(",
				"cellX = centerCellX + cellOffsetX",
				"cellZ = centerCellZ + cellOffsetZ",
			")",
			"long cellSeed = (worldSeed # 16x89DF1A40CD5A52AAUL).newSeed(cellX, cellZ)",
			"int*(",
				"relativeX = x - (cellX << 8 | (cellSeed := cellSeed.newSeed()).nextInt(256))",
				"relativeZ = z - (cellZ << 8 | (cellSeed := cellSeed.newSeed()).nextInt(256))",
			")",
			"double*(",
				"angle = (cellSeed := cellSeed.newSeed()).nextDouble(tau)",
				"cosAngle = fastCos(angle)",
				"sinAngle = fastSin(angle)",
				"transformedX = (cosAngle * relativeX - sinAngle * relativeZ) / 128.0L",
				"transformedZ = (sinAngle * relativeX + cosAngle * relativeZ) / 128.0L",
			")",
			"for (int y in range[-64, 192):",
				"double transformedY = (128.0L - y) / 128.0L",
				"double bias = parabolaSDFSquared(transformedX, transformedY, transformedZ)",
				"bias *= fastExp2(transformedY * -6.0L + 6.0L)",
				"if (bias < 1.0L:",
					"`bigglobe:arches/base_noise`(y) -= float(2.0L * (1.0L - bias) ^ 2)",
				")",
			")",
		")"
	]
}