{
	"type": "multi_state_3d",
	"state": [
		"double decay = sqrt(0.5L)",
		"BlockState checkPosition(double*(x1, y1, z1, r1, x2, y2, z2, r2), long seed, int recursionLevel:",
			"double*(",
				"dx  = x2 - x1",
				"dy  = y2 - y1",
				"dz  = z2 - z1",
				"dr2 = dx ^ 2 + dy ^ 2 + dz ^ 2",
				"dr  = sqrt(dr2)",
				"ox1 = x  - x1",
				"oy1 = y  - y1",
				"oz1 = z  - z1",
				"ox2 = x  - x2",
				"oy2 = y  - y2",
				"oz2 = z  - z2",
				"or2 = sqrt(ox2 ^ 2 + oy2 ^ 2 + oz2 ^ 2)",
			")",
			"if (or2 < dr / (1.0L - decay):",
				"double*(",
					"dot = clamp(0.0L, 1.0L, (ox1 * dx + oy1 * dy + oz1 * dz) / dr2)",
					"px = dx * dot",
					"py = dy * dot",
					"pz = dz * dot",
					"projDist = (",
						"+ (ox1 - px) ^ 2",
						"+ (oy1 - py) ^ 2",
						"+ (oz1 - pz) ^ 2",
					")",
					"threshold = mixLinear(r1, r2, dot) ^ 2",
				")",
				"if (projDist < threshold:",
					"return(dr < 4.0L << hints.lod ? 'minecraft:oak_leaves[distance=7,persistent=true,waterlogged=false]' : 'minecraft:oak_wood[axis=y]')",
				")",
				"else if (dr >= 2.0L << hints.lod && dot > 0.0L:",
					"double*(",
						"ndx = dx / dr",
						"ndy = dy / dr",
						"ndz = dz / dr",
						"latitude = seed.newSeed(1).nextDouble(-1.0L, +1.0L)",
						"longitude = seed.newSeed(2).nextDouble(tau)",
						"sphere = sqrt(1.0L - latitude ^ 2)",
						"offsetX = fastCos(longitude) * sphere",
						"offsetY = latitude",
						"offsetZ = fastSin(longitude) * sphere",
						"dot2 = ndx * offsetX + ndy * offsetY + ndz * offsetZ",
					")",
					"offsetX -= dot2 * ndx",
					"offsetY -= dot2 * ndy",
					"offsetZ -= dot2 * ndz",
					"double offsetR = sqrt(offsetX ^ 2 + offsetY ^ 2 + offsetZ ^ 2)",
					"offsetX /= offsetR",
					"offsetY /= offsetR",
					"offsetZ /= offsetR",
					"double*(",
						"sideX = ndy * offsetZ - ndz * offsetY",
						"sideY = ndz * offsetX - ndx * offsetZ",
						"sideZ = ndz * offsetY - ndy * offsetX",
					")",
					"int count = seed.newSeed(3).nextBetween[2, 3]",
					"for (int branch in range[0, count):",
						"double*(",
							"sinBranch = fastSin(branch * tau / count)",
							"cosBranch = fastCos(branch * tau / count)",
							"x3 = ndx + offsetX * cosBranch + sideX * sinBranch",
							"y3 = ndy + offsetY * cosBranch + sideY * sinBranch + 0.75L / count",
							"z3 = ndz + offsetZ * cosBranch + sideZ * sinBranch",
							"r3 = decay * dr / sqrt(x3 ^ 2 + y3 ^ 2 + z3 ^ 2)",
						")",
						"x3 = x2 + x3 * r3",
						"y3 = y2 + y3 * r3",
						"z3 = z2 + z3 * r3",
						"if (BlockState*(state := checkPosition(x2, y2, z2, r2, x3, y3, z3, r2 * decay + (1.0L - decay), seed.newSeed(4, branch), recursionLevel + 1)) != null:",
							"return(state)",
						")",
					")",
				")",
			")",
			"return(null)",
		")",
		"BlockState checkForest(int*(offsetX, offsetZ, scale), long seed, double amplitude:",
			"int centerX = (x - offsetX + (1 << (scale - 1))) >> scale",
			"int centerZ = (z - offsetZ + (1 << (scale - 1))) >> scale",
			"seed = seed.newSeed(scale, centerX, centerZ)",
			"int jitter = 1 << (scale - 3)",
			"centerX = centerX << scale + offsetX + seed.newSeed(1).nextInt(-jitter, jitter)",
			"centerZ = centerZ << scale + offsetZ + seed.newSeed(2).nextInt(-jitter, jitter)",
			"double height = seed.newSeed(3).nextDouble(0.5L, 1.0L) * amplitude",
			"double radius = height * 0.125L",
			"return(checkPosition(centerX, 0.0L, centerZ, radius, centerX, height, centerZ, radius * decay + (1.0L - decay), seed.newSeed(100), 0))",
		")",
		"BlockState state = null",
		"if ((state := checkForest(  0,   0, 10, worldSeed.newSeed( 1), 128.0L)) != null: return(state))",
		"if ((state := checkForest(512, 512, 10, worldSeed.newSeed( 2), 128.0L)) != null: return(state))",
		"if ((state := checkForest(512,   0, 10, worldSeed.newSeed( 3),  96.0L)) != null: return(state))",
		"if ((state := checkForest(  0, 512, 10, worldSeed.newSeed( 4),  96.0L)) != null: return(state))",
		"if ((state := checkForest(256, 256,  9, worldSeed.newSeed( 5),  64.0L)) != null: return(state))",
		"if ((state := checkForest(256,   0,  9, worldSeed.newSeed( 6),  48.0L)) != null: return(state))",
		"if ((state := checkForest(  0, 256,  9, worldSeed.newSeed( 7),  48.0L)) != null: return(state))",
		"if ((state := checkForest(128, 128,  8, worldSeed.newSeed( 8),  32.0L)) != null: return(state))",
		"if ((state := checkForest(128,   0,  8, worldSeed.newSeed( 9),  24.0L)) != null: return(state))",
		"if ((state := checkForest(  0, 128,  8, worldSeed.newSeed(10),  24.0L)) != null: return(state))",
		"return(null)"
	],
	"valid": {
		"min_y": "world_traits.`bigglobe:y_level_on_surface`",
		"max_y": "world_traits.`bigglobe:max_y`",
		"where": "hints.usage !=. 'heightmap'"
	}
}