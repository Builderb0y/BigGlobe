{
	"script": [
		"double*(",
			"caveNoise = `bigglobe:nether/bubble/raw_cave_noise`",
			"caveWidth = `bigglobe:nether/bubble/cave_width`",
			"adjustedCaves = 1.0L - 1.0L / (caveNoise / caveWidth ^ 2 + 1.0L)",
			"top = unmixSmoother(",
				"double(`bigglobe:nether/mid_y` + `bigglobe:nether/cavern_fade_radius`),",
				"double(`bigglobe:nether/mid_y` - `bigglobe:nether/cavern_fade_radius`),",
				"double(y)",
			")",
			"bottom = ((1.0L - soft_distance) * y) ^ 2 / 256.0L + 1.0L",
			"terrainNoise = mixLinear(",
				"CAVERN_NOISE,",
				"`bigglobe:nether/noise_edge`,",
				"unmixSmoother(0.875L, 1.0L, soft_distance)",
			")",
			"adjustedTerrain = mixLinear(1.0I, terrainNoise, `bigglobe:nether/bubble/cavern_scalar`(y))",
			"result = adjustedCaves * adjustedTerrain + top / bottom",
		")",
		"if (y < lava_level:",
			"result += unmixLinear(lava_level, `bigglobe:nether/min_y` + 16.0L, y) ^ 2",
		")",
		"else if (y > `bigglobe:nether/max_y` - 32:",
			"result += unmixLinear(`bigglobe:nether/max_y` - 32.0L, `bigglobe:nether/max_y` - 16.0L, y) ^ 2",
		")",
		"float(result)"
	],
	"inputs": [
		{ "name": "CAVERN_NOISE", "type": "float" }
	]
}