{
	"type": "noise",
	"params": {
		"type": "float",
		"is_3d": false
	},
	"grid": {
		"type": "script",
		"min": -32.0,
		"max":  32.0,
		"script": [
			"double result = base",
			"if (positiveOffset > 0.0L: result += 16.0L)",
			"if (negativeOffset > 0.0L: result -= 16.0L)",
			"result"
		],
		"inputs": {
			"base": {
				"type": "sum",
				"layers": [
					{ "type": "smooth", "scale": 256, "amplitude": 64.0 },
					{ "type": "smooth", "scale": 128, "amplitude": 32.0 },
					{ "type": "smooth", "scale":  64, "amplitude": 16.0 }
				]
			},
			"positiveOffset": {
				"type": "sum",
				"layers": [
					{ "type": "smooth", "scale": 64, "amplitude": 16.0 },
					{ "type": "smooth", "scale": 32, "amplitude":  8.0 },
					{ "type": "smooth", "scale": 16, "amplitude":  4.0 }
				]
			},
			"negativeOffset": {
				"type": "sum",
				"layers": [
					{ "type": "smooth", "scale": 64, "amplitude": 16.0 },
					{ "type": "smooth", "scale": 32, "amplitude":  8.0 },
					{ "type": "smooth", "scale": 16, "amplitude":  4.0 }
				]
			}
		}
	}
}