{
	"type": "bigglobe:script",
	"config": {
		"script": [
			"if (int*(y := world_traits.`bigglobe:lava_y`).isBetween[minValidYLevel, maxValidYLevel):",
				"placeFeature(0, y, 0, 'bigglobe:nether/decorators/lava_normal')",
			")",
			"if (hints.decorate:",
				"placeFeature(0, 0, 0, 'bigglobe:nether/ores/ancient_debris_at_random_y_level')",
				"placeFeature(0, 0, 0, 'bigglobe:nether/ores/ancient_debris_under_lava')",
			")",
			"for (int baseY in range[minValidYLevel, maxValidYLevel) % 16:",
				"int y = baseY | (worldSeed # 16x5EBDEDC4EE513888UL).newSeed(placementX, placementZ, baseY).nextInt(16)",
				"BlockState originState = getBlockState(0, y, 0)",
				"if (originState.isAir():",
					"BlockState above = getBlockState(0, y + 1, 0)",
					"BlockState below = getBlockState(0, y - 1, 0)",
					"if (below ==. 'minecraft:sulfur':",
						"placeFeature(0, y, 0, random.switch (",
							"4.0: 'bigglobe:nether/sulfur_pool',",
							"1.0: 'bigglobe:nether/sulfur_spike_group',",
							"0.25: 'bigglobe:nether/mega_sulfur_stalagmite'",
						"))",
					")",
					"else if (below ==. 'minecraft:cinnabar':",
						"placeFeature(0, y, 0, random.switch (",
							"4.0: 'bigglobe:nether/cinnabar_pool',",
							"1.0: 'bigglobe:nether/cinnabar_spike_group',",
							"0.25: 'bigglobe:nether/mega_cinnabar_stalagmite'",
						"))",
					")",
					"else if (above.isIn('#minecraft:base_stone_nether'):",
						"random.if (1.0I / 64.0I: placeFeature(0, y, 0, 'bigglobe:nether/glowstone/normal'))",
					")",
					"else if (above ==. 'minecraft:sulfur':",
						"placeFeature(0, y, 0, random.switch (",
							"1.0: 'bigglobe:nether/sulfur_spike_group',",
							"0.25: 'bigglobe:nether/mega_sulfur_stalactite'",
						"))",
					")",
					"else if (above ==. 'minecraft:cinnabar':",
						"placeFeature(0, y, 0, random.switch (",
							"1.0: 'bigglobe:nether/cinnabar_spike_group',",
							"0.25: 'bigglobe:nether/mega_cinnabar_stalactite'",
						"))",
					")",
				")",
				"else if (hints.decorate && random.nextBoolean() && originState.isIn('#minecraft:base_stone_nether'):",
					"placeFeature(0, y, 0, 'bigglobe:nether/random_sized_magma_in_netherrack')",
				")",
			")",
			"true"
		]
	}
}