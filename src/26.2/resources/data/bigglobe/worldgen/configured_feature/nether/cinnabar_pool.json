{
	"type": "bigglobe:script",
	"config": {
		"script": [
			"SmallPoolGenerator pool = new().=$groundReplaceable('minecraft:cinnabar')",
			"pool.spread(world, 0, 0, 0).if (",
				"for (ColumnPos pos in pool.surroundingColumns:",
					"if (random.nextInt(4) == 0:",
						"placeFeature(pos.x, 1, pos.z, 'bigglobe:nether/cinnabar_stalagmite')",
					")",
				")",
				"for (ColumnPos pos in pool.fluidColumns:",
					"setBlockState(pos.x, 0, pos.z, 'minecraft:lava[level=0]')",
				")",
			")"
		]
	}
}