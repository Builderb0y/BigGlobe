{
	"element_type": "method/normal",
	"name": "computeBoundsAndDepth",
	"return_type": "boolean",
	"parameters": [],
	"code": [
		"if (_computedBoundsDepth == 0Y:",
			"_computedBoundsDepth = 1Y",
			"double*(",
				"distance = soft_distance * 1.125L",
				"center = average_center_y + spiral_mountain_center",
				"direction = (worldSeed # 16xBF3601F0B09F727BUL).newSeed(cell_x, cell_z).nextBoolean() ? 8.0L : -8.0L",
				"spiral = distance == 0.0L ? 0.0L : fastSin(fastAtan2(x - center_x, z - center_z) * 8.0L + fastLog2(distance) * direction) * 0.5L * distance * exp(-4.0L * distance)",
				"bias = exclusion",
				"rawUpperCurve = (1.0L - distance) / (4.0L * distance + 1.0L)",
				"rawLowerCurve = (1.0L - distance ^ 2) * 0.25L",
				"upperCurve = center + 128.0L * (rawUpperCurve - bias + spiral)",
				"lowerCurve = center - 128.0L * (rawLowerCurve - bias)",
			")",
			"unless (upperCurve > lowerCurve: return(false))",
			"_computedBoundsDepth = 2Y",
			"_lowerBound = lowerCurve",
			"_upperBound = upperCurve",
			"_surfaceDepth = floorInt(columnSeed(16xE1194746F0739D03UL).nextDouble(2.0L, 7.0L) - spiral * 32.0L - rawUpperCurve * 8.0L).as(byte)",
			"return(true)",
		")",
		"else (",
			"return(_computedBoundsDepth == 2Y)",
		")"
	]
}