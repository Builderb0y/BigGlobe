{
	"type": "column_value",
	"script": {
		"source": [
			"for (StructureStart start in structures:",
				"double distance = distanceToSquare(start)",
				"int minY = start.minY",
				"if (start.structure ==. 'bigglobe:log_cabin': ++minY)",
				"double mixLevel = smooth(distance * 0.0625)",
				"setSurfaceY(minY - 0.5L, mixLevel, keepSnow)",
				"setSurfaceFoliage(minY, mixLevel)",
				"setSnowY(world_traits.`bigglobe:automatic_exact_surface_y`(start.minY), smooth(distance * 0.03125L))",
			")"
		],
		"includes": [
			"bigglobe:include/surface_manipulation"
		]
	},
	"structure_filter": {
		"structure": [
			"bigglobe:medium_house",
			"bigglobe:large_house",
			"bigglobe:log_cabin"
		],
		"radius_in_chunks": 3
	}
}