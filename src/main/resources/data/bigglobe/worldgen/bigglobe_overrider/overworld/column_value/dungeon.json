{
	"type": "column_value",
	"feature_generation": false,
	"script": [
		"if (!hints.carve: return())",
		"for (StructureStart start in structures:",
			"int structureMinY = start.minY",
			"int structureMaxY = start.maxY",
			"int bufferMinY = structureMinY - 64",
			"int bufferMaxY = structureMaxY + 64",
			"float horizontalFactor = (distanceToCircle(start).as(float) / 48.0I) ^ 2",
			"for (",
				"int y in range[",
					"max(bufferMinY, world_traits.`bigglobe:cave_min_y`),",
					"min(bufferMaxY, world_traits.`bigglobe:cave_max_y`)",
				")",
			":",
				"float verticalFactor = ((clamp(double(structureMinY), double(structureMaxY), double(y)) - double(y)).as(float) / 48.0I) ^ 2",
				"float combinedFactor = min(horizontalFactor + verticalFactor, 1.0)",
				"world_traits.`bigglobe:cave_noise`(y) *= combinedFactor * (2.0 - combinedFactor)",
			")",
		")"
	],
	"structure_filter": {
		"structure": "#bigglobe:dungeons",
		"radius_in_chunks": 3
	}
}