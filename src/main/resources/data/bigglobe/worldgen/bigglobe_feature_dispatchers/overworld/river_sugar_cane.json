{
	"type": "bigglobe:script",
	"dispatcher": [
		"int*(",
			"rng = random.nextInt()",
			"x = minModifiableX | (rng & 15)",
			"z = minModifiableZ | ((rng >>> 4) & 15)",
		")",
		"if (world_traits.`bigglobe:in_river`(x, z):",
			"int y = world_traits.`bigglobe:y_level_on_surface`(x, z)",
			"if (getBlockState(x, y, z).isAir() && !placeBlockState(x, y, z, 'minecraft:lily_pad'):",
				"placeFeature(x, y, z, 'bigglobe:overworld/sugar_cane_patch')",
			")",
		")"
	]
}