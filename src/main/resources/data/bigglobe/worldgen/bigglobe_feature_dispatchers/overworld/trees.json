{
	"type": "script",
	"dispatcher": [
		"repeat (random.roundInt(world_traits.`bigglobe:foliage_at_surface`(minModifiableX | 8, minModifiableZ | 8) * 16.0I):",
			"int x = minModifiableX | random.nextInt(16)",
			"int z = minModifiableZ | random.nextInt(16)",
			"int y = world_traits.`bigglobe:y_level_on_surface`(x, z)",
			"if (",
				"world_traits.`bigglobe:foliage_at_surface`(x, z) > 0.0L &&",
				"`bigglobe:overworld/unbounded_river_dip`(x, z) > 1.0L",
			":",
				"ConfiguredFeature feature = `bigglobe:overworld/foliage_feature`(x, z)",
				"if (feature != null: placeFeature(x, y, z, feature))",
			")",
		")"
	]
}