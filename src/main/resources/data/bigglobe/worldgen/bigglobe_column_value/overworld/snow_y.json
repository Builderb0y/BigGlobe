{
	"type": "bigglobe:script",
	"params": {
		"type": "double",
		"is_3d": false
	},
	"script": [
		"double snowHeight = height_adjusted_snow_y",
		"double terrainHeight = exact_surface_y",
		"if (terrainHeight - sea_level < 32.0L:",
			"snowHeight = mixSmooth(",
				"terrainHeight,",
				"snowHeight,",
				"(terrainHeight - sea_level) / 32.0L",
			")",
		")",
		"return(snowHeight)"
	]
}