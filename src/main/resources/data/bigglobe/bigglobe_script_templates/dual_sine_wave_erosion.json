{
	"script": [
		"double*(",
			"scalar    = 0.5L / sqrt(dx ^ 2 + dz ^ 2 + 1.0L)",
			"highAdded = 0.0L",
			"highDx    = dx * scalar",
			"highDz    = dz * scalar",
			"lowAdded  = 0.0L",
			"lowDx     = dx * scalar",
			"lowDz     = dz * scalar",
		")",
		"if (maxWavelength >= minWavelength:",
			"double*(",
				"theta      = seed.nextDouble(tau)",
				"unitX      = cos(theta)",
				"unitZ      = sin(theta)",
				"goldenCos  = cos(goldenAngle)",
				"goldenSin  = sin(goldenAngle)",
				"decay      = 2.0L ^ (-1.0L / 64.0L)",
			")",
			"minWavelength /= tau",
			"maxWavelength /= tau",
			"for (double wavelength = maxWavelength, wavelength >= minWavelength, wavelength *= decay:",
				"double*(",
					"phase             = (seed := seed.newSeed()).nextDouble(tau)",
					"rcpDerivative     = 0.5L / sqrt(highDx ^ 2 + highDz ^ 2 + 1.0L)",
					"projection        = (unitX * x + unitZ * z) / wavelength + phase - 32.0L * highAdded * (unitX * highDx + unitZ * highDz) * rcpDerivative",
					"adjustedAmplitude = ((unitX * -highDz + unitZ * highDx) * rcpDerivative) ^ 2",
					"toAdd             = fastSin(projection) * adjustedAmplitude * wavelength / maxWavelength",
					"addedDerivative   = fastCos(projection) * adjustedAmplitude",
					"nextUnitX         = unitX * goldenCos + unitZ * -goldenSin",
					"nextUnitZ         = unitX * goldenSin + unitZ *  goldenCos",
				")",
				"highAdded += toAdd",
				"highDx    += addedDerivative * unitX",
				"highDz    += addedDerivative * unitZ",
				"if (wavelength >= midWavelength:",
					"if (wavelength < midWavelength * 2.0L:",
						"double multiplier = unmixSmooth(midWavelength, midWavelength * 2.0L, wavelength)",
						"toAdd *= multiplier",
						"addedDerivative *= multiplier",
					")",
					"lowAdded += toAdd",
					"lowDx    += addedDerivative * unitX",
					"lowDz    += addedDerivative * unitZ",
				")",
				"unitX = nextUnitX",
				"unitZ = nextUnitZ",
			")",
		")",
		"return(",
			"DualSineWaveErosionData.new(",
				"SineWaveErosionData.new(highAdded * amplitude + highY, highDx, highDz),",
				"SineWaveErosionData.new( lowAdded * amplitude +  lowY,  lowDx,  lowDz)",
			")",
		")"
	],
	"inputs": [
		{ "name": "lowY",          "type": "double", "default": "0.0L" },
		{ "name": "highY",         "type": "double", "default": "0.0L" },
		{ "name": "dx",            "type": "double" },
		{ "name": "dz",            "type": "double" },
		{ "name": "minWavelength", "type": "double" },
		{ "name": "midWavelength", "type": "double" },
		{ "name": "maxWavelength", "type": "double" },
		{ "name": "amplitude",     "type": "double" },
		{ "name": "seed",          "type": "long"   }
	]
}