		"sources": {
			"tab": {
				"type": "derived",
				"code": [
					"float4 color = wildflowers(UV);",
					"if (color.g > (color.r + color.b) * 0.71) return color;",
					"\"blue",
					"if (true) {",
					"\tif (color.b > 0.5) {",
					"\t\treturn color.rrga * float4(0.25, 0.25, 1.0, 1.0);",
					"\t}",
					"\telse {",
					"\t\treturn color.ggra * float4(0.375, 0.5, 1.0, 1.0);",
					"\t}",
					"}",
					"\"red",
					"else if (false) {",
					"\tif (color.b > 0.5) {",
					"\t\tfloat sat = color.g * 1.0 - 0.75;",
					"\t\treturn color.grra * float4(1.0, sat, sat, 1.0);",
					"\t}",
					"\telse {",
					"\t\treturn color.rgga * float4(1.0, 2.0, 0.125, 1.0) - float4(0.0, 1.0, 0.0, 0.0);",
					"\t}",
					"}",
					"\"purple",
					"else {",
					"\tif (color.b > 0.5) {",
					"\t\treturn color.rrga * float4(0.75, 1.0, 1.0, 1.0) - float4(0.0, 0.5, 0.0, 0.0);",
					"\t}",
					"\telse {",
					"\t\treturn color.ggra * float4(0.5, 0.25, 1.0, 1.0);",
					"\t}",
					"}"
				]
			}
		},
		"expanded": true
	},
