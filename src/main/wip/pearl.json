						"type": "derived",
						"code": [
							"float2 uv2 = uv * 2.0 - 1.0;",
							"uv2 = uv2 * 1.125;",
							"float r = length(uv2);",
							"if (r < 1.0) {",
							"\tfloat brightness = mix(blur(UV).x, 1.0, r ^ 2 * 0.875);",
							"\tfloat z = sqrt(1.0 - dot(uv2, uv2));",
							"\tfloat3 normal = float3(...uv2, z);",
							"\tfloat3 ray = float3(0.0, 0.0, -1.0);",
							"\tray = ray - 2.0 * normal * dot(ray, normal);",
							"\tfloat3 light = normalize(float3(-1.0, 1.0, 1.0));",
							"\tfloat specular = max(dot(ray, light), 0.0) ^ 2;",
							"\tbrightness = mix(brightness, 1.0, specular);",
							"\treturn float4(brightness, brightness, brightness, 1.0);",
							"}",
							"else {",
							"\treturn float4(0.0);",
							"}"
						]
					}
				},
				"expanded": true
			}
