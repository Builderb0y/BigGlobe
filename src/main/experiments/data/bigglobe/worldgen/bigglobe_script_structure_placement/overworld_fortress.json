{
	"raw_placement": [
		"int adj = data.adj",
		"int flag(int*(x, y, z):",
			"1 << (y * 9 + (z + 1) * 3 + (x + 1))",
		")",
		"boolean has(int*(x, y, z):",
			"adj & flag(x, y, z) != 0",
		")",
		"for (int*(x, z) in range[-2, 2]:",
			"int*(x1 = sign(x), z1 = sign(z), x2 = x - x1, z2 = z - z1)",
			"void ledge(:",
				"setBlockState(x, 4, z, 'minecraft:smooth_stone_slab[type=double,waterlogged=false]')",
				"setBlockStateAuto(x, 5, z, 'minecraft:cobblestone_wall')",
			")",
			"void stone(: setBlockState(x, 4, z, 'minecraft:stone'))",
			"void log(: fillBlockState(x, 0, z, x, 3, z, 'minecraft:spruce_log[axis=y]'))",
			"void brick(:",
				"if (x == 0 || z == 0 && random.nextBoolean():",
					"setBlockState(x, 0, z, 'minecraft:stone_bricks')",
					"setBlockStateAuto(x, 1, z, 'minecraft:glass_pane')",
					"setBlockStateAuto(x, 2, z, 'minecraft:glass_pane')",
					"setBlockState(x, 3, z, 'minecraft:stone_bricks')",
				")",
				"else (",
					"fillBlockState(x, 0, z, x, 3, z, 'minecraft:stone_bricks')",
				")",
			")",
			"void upperLog(: setBlockState(x, 4, z, 'minecraft:spruce_log[axis=y]'))",
			"void upperBrick(: setBlockState(x, 4, z, 'minecraft:stone_bricks'))",
			"",
			"switch (x ^ 2 + z ^ 2:",
				"case (0:",
					"stone()",
				")",
				"case (1:",
					"unless (has(x1, 0, z1): brick())",
					"if (has(0, 1, 0) && !has(x1, 0, z1): upperBrick())",
					"else (stone())",
				")",
				"case (2:",
					"unless (has(x1, 0, z1) && has(x1, 0, 0) && has(0, 0, z1): brick())",
					"if (has(0, 1, 0) && (!has(x1, 0, 0) || !has(0, 0, z1)): upperBrick())",
					"else (stone())",
				")",
				"case (4:",
					"if (has(x2, 0, z2): stone())",
					"else unless (has(0, 1, 0): ledge())",
				")",
				"case (5:",
					"if (has(x2, 0, z2):",
						"boolean log = !(has(x1, 0, z1) && has(x1, 0, 0) && has(0, 0, z1))",
						"if (log: brick())",
						"if (log && has(0, 1, 0) && has(x2, 1, z2): upperBrick())",
						"else (stone())",
					")",
					"else unless (has(0, 1, 0):",
						"ledge()",
					")",
				")",
				"case (8:",
					"unless (has(x1, 0, z1) && has(x1, 0, 0) && has(0, 0, z1):",
						"log()",
						"if (has(0, 1, 0) || has(x1, 1, 0) || has(0, 1, z1) || has(x1, 1, z1): upperLog())",
						"else (ledge())",
					")",
					"else (stone())",
				")",
			")",
		")",
		"unless (has(0, 1, 0):",
			"unless (has(1, 0, 0):",
				"unless (has(1, 0, -1) || has(0, 1, -1):",
					"setBlockState(3, 4, -2, 'minecraft:stone_button[face=wall,facing=east,powered=false]')",
				")",
				"unless (has(1, 0, 1) || has(0, 1, 1):",
					"setBlockState(3, 4, 2, 'minecraft:stone_button[face=wall,facing=east,powered=false]')",
				")",
			")",
			"unless (has(-1, 0, 0):",
				"unless (has(-1, 0, -1) || has(0, 1, -1):",
					"setBlockState(-3, 4, -2, 'minecraft:stone_button[face=wall,facing=west,powered=false]')",
				")",
				"unless (has(-1, 0, 1) || has(0, 1, 1):",
					"setBlockState(-3, 4, 2, 'minecraft:stone_button[face=wall,facing=west,powered=false]')",
				")",
			")",
			"unless (has(0, 0, 1):",
				"unless (has(-1, 0, 1) || has(-1, 1, 0):",
					"setBlockState(-2, 4, 3, 'minecraft:stone_button[face=wall,facing=south,powered=false]')",
				")",
				"unless (has(1, 0, 1) || has(1, 1, 0):",
					"setBlockState(2, 4, 3, 'minecraft:stone_button[face=wall,facing=south,powered=false]')",
				")",
			")",
			"unless (has(0, 0, -1):",
				"unless (has(-1, 0, -1) || has(-1, 1, 0):",
					"setBlockState(-2, 4, -3, 'minecraft:stone_button[face=wall,facing=north,powered=false]')",
				")",
				"unless (has(1, 0, -1) || has(1, 1, 0):",
					"setBlockState(2, 4, -3, 'minecraft:stone_button[face=wall,facing=north,powered=false]')",
				")",
			")",
		")"
	],
	"placement": [
		"repeat (4:",
			"placeFeature(",
				"random.nextInt(-3, 4),",
				"random.nextInt(5),",
				"random.nextInt(-3, 4),",
				"'minecraft:vines'",
			")",
		")",
		"repeat (16:",
			"int x = random.nextInt(-1, 2)",
			"int y = random.nextInt(5)",
			"int z = random.nextInt(-1, 2)",
			"if (getBlockState(x, y, z) ==. 'minecraft:stone_bricks':",
				"setBlockState(x, y, z, random.if ('minecraft:cracked_stone_bricks') else ('minecraft:mossy_stone_bricks'))",
			")",
		")"
	]
}