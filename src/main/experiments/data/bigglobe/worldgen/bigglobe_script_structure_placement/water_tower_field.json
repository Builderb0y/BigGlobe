{
	"raw_placement": [
		"int*(",
			"iterMinX = max(minX, chunkMinX)",
			"iterMinY = max(minY, chunkMinY)",
			"iterMinZ = max(minZ, chunkMinZ)",
			"iterMaxX = min(maxX, chunkMaxX)",
			"iterMaxY = min(maxY, chunkMaxY)",
			"iterMaxZ = min(maxZ, chunkMaxZ)",
		")",
		"double structCenterSurfaceY = world_traits.`bigglobe:exact_surface_y`(midX, midZ)",
		"class CenterPoint(double*(x, y, z))",
		"NbtList centersNbt = data.centers.as(NbtList)",
		"ArrayList centers = new(centersNbt.size)",
		"for (NbtCompound nbt in centersNbt:",
			"double*(",
				"centerX = nbt.x.asFloat() + midX",
				"centerY = nbt.y.asFloat() + structCenterSurfaceY",
				"centerZ = nbt.z.asFloat() + midZ",
			")",
			"if (abs(iterMinX + 8 - centerX) <= 32.0L && abs(iterMinZ + 8 - centerZ) <= 32.0L:",
				"centers.add(CenterPoint.new(centerX, centerY, centerZ))",
			")",
		")",
		"for (",
			"int z in range[iterMinZ, iterMaxZ],",
			"int x in range[iterMinX, iterMaxX]",
		":",
			"int surfaceY = world_traits.`bigglobe:y_level_on_surface`(int(x), int(z))",
			"int surfaceRemaining = random.nextInt(1, 5)",
			"for (int y in -range[surfaceY, iterMaxY]:",
				"double sdf = 0.0L",
				"for (CenterPoint center in centers:",
					"double*(",
						"relativeX = x - center.x",
						"relativeY = y - center.y",
						"relativeZ = z - center.z",
						"relativeH2 = relativeX ^ 2 + relativeZ ^ 2",
					")",
					"sdf += fastExp2(-(relativeH2 / 4.0L + max(relativeY + 4.0L, 0.0L) ^ 2))",
					"sdf += fastExp2(-(relativeH2 / 64.0L + relativeY ^ 2 / 16.0L))",
				")",
				"sdf = -fastLog2(sdf)",
				"if (sdf <= 1.0L:",
					"setBlockState(x, y, z, :--surfaceRemaining >= 0 ? 'minecraft:moss_block' : 'minecraft:mushroom_stem')",
				")",
				"else (",
					"surfaceRemaining = random.nextInt(1, 5)",
				")",
			")",
		")"
	],
	"placement": "noop"
}