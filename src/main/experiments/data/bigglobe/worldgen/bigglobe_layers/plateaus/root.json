{
	"type": "bigglobe:root",
	"state": "'minecraft:air'",
	"children": [
		"bigglobe:plateaus/terracotta"
	],
	"after_children": [
		"if (",
			"int*(",
				"surfaceY = int(`bigglobe:plateaus/plateau_y` + `bigglobe:plateaus/base_noise`)",
				"depth := int(",
					"(",
						"`bigglobe:plateaus/plateau_y` == 128.0",
						"? 4.0L",
						": 4.0L - `bigglobe:plateaus/plateau_y` * 0.25L",
					")",
					"+ (columnSeed # 16x979303DE39989D2FUL).nextDouble(2.0L)",
				")",
			")",
			"> 0",
		":",
			"setBlockStates(surfaceY - depth, surfaceY, 'minecraft:dirt')",
			"setBlockState(surfaceY - 1, 'minecraft:grass_block[snowy=false]')",
		")"
	]
}