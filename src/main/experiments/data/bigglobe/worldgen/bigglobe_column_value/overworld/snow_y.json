{
	"type": "bigglobe:script",
	"params": {
		"type": "double",
		"is_3d": false
	},
	"script": [
		"double snowHeight = height_adjusted_snow_y",
		"double terrainHeight = basic_surface_y",
		"if (terrainHeight - river_water_y < 32.0L:",
			"snowHeight = mixSmooth(",
				"terrainHeight,",
				"snowHeight,",
				"(terrainHeight - river_water_y) / 32.0L",
			")",
		")",
		"double quantizedHeight = quantized.center_column.`bigglobe:overworld/basic_surface_y`",
		"snowHeight += quantizedHeight - terrainHeight",
		"return(snowHeight)"
	],
	"valid": {
		"where": "processed_surface_y > sea_level"
	}
}