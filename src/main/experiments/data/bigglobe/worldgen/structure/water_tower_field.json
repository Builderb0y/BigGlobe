{
	"type": "bigglobe:script",
	"biomes": "#bigglobe:has_structure/water_tower_field",
	"spawn_overrides": {},
	"step": "raw_generation",
	"max_radius_in_chunks": 16,
	"layout": [
		"double*(",
			"structCenterSurfaceY = world_traits.`bigglobe:exact_surface_y`(originX, originZ)",
			"radius = random.nextDouble(128.0L, 256.0L)",
			"minSurfaceY = structCenterSurfaceY",
			"maxSurfaceY = structCenterSurfaceY",
			"minStructureY = structCenterSurfaceY",
			"maxStructureY = structCenterSurfaceY",
		")",
		"NbtList centers = nbtList()",
		"NbtCompound data = nbtCompound(centers: centers)",
		"int attempts = int((radius / 8.0L) ^ 2)",
		"for (int attempt in range[0, attempts):",
			"double*(",
				"theta = attempt * goldenAngle",
				"r = sqrt(double(attempt) / double(attempts)) * radius",
				"centerX  = cos(theta) * r + originX",
				"centerZ  = sin(theta) * r + originZ",
				"surfaceY = world_traits.`bigglobe:exact_surface_y`(int(centerX), int(centerZ))",
				"centerY  = surfaceY + random.nextDouble(16.0L, 64.0L - (r / radius) ^ 2 * 32.0L)",
			")",
			"if (Grid2D('bigglobe:water_tower_field').getValue(int(centerX), int(centerZ)) > 0.0L:",
				"if (world_traits.`bigglobe:biome`(int(centerX), int(surfaceY), int(centerZ)).isIn('#bigglobe:has_structure/water_tower_field'):",
					"minSurfaceY = min(minSurfaceY, surfaceY)",
					"maxSurfaceY = max(maxSurfaceY, surfaceY)",
					"if (maxSurfaceY - minSurfaceY > radius * 0.5L:",
						"return()",
					")",
					"minStructureY = min(minStructureY, surfaceY)",
					"maxStructureY = max(maxStructureY, centerY)",
					"centers.add(",
						"nbtCompound(",
							"x: float(centerX - originX),",
							"y: float(centerY - structCenterSurfaceY),",
							"z: float(centerZ - originZ)",
						")",
					")",
				")",
			")",
		")",
		"unless (centers.isEmpty():",
			"pieces.add(",
				"ScriptStructurePiece.new(",
					"originX - int(radius) - 32,",
					"int(minStructureY) - 16,",
					"originZ - int(radius) - 32,",
					"originX + int(radius) + 32,",
					"int(maxStructureY) + 16,",
					"originZ + int(radius) + 32,",
					"'bigglobe:water_tower_field',",
					"data",
				")",
			")",
		")"
	]
}