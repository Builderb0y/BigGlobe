{
	"type": "bigglobe:script",
	"biomes": "#bigglobe:has_structure/overworld_fortress",
	"spawn_overrides": {},
	"step": "surface_structures",
	"layout": [
		"int*(",
			"MAX_RADIUS   = 16",
			"MAX_DIAMETER = MAX_RADIUS * 2 + 1",
			"MAX_AREA     = MAX_DIAMETER ^ 2",
			"MAX_LAYERS   = 16",
			"MAX_VOLUME   = MAX_AREA * MAX_LAYERS",
			"originY      = 64",
		")",
		"NumberArray positions = newBooleanArray(MAX_VOLUME)",
		"int encodeIndex(int*(x, y, z):",
			"y * MAX_AREA + (z + MAX_RADIUS) * MAX_DIAMETER + (x + MAX_RADIUS)",
		")",
		"boolean hasAt(int*(x, y, z):",
			"x.isBetween[-MAX_RADIUS, MAX_RADIUS] &&",
			"z.isBetween[-MAX_RADIUS, MAX_RADIUS] &&",
			"(y < 0 || (y < MAX_LAYERS && positions.(encodeIndex(x, y, z))))",
		")",
		"int previousArea = MAX_AREA",
		"for (int layer in range[0, MAX_LAYERS):",
			"boolean hasAll(int*(minX, minZ, maxX, maxZ):",
				"for (int z in range[minZ, maxZ], int x in range[minX, maxX]:",
					"unless (hasAt(x, layer - 1, z): return(false))",
					"if  (hasAt(x, layer, z): return(false))",
				")",
				"return(true)",
			")",
			"for (int placementAttempt in range[0, layer << 3 + 8):",
				"int*(",
					"centerX = random.nextInt(-MAX_RADIUS, MAX_RADIUS + 1)",
					"centerZ = random.nextInt(-MAX_RADIUS, MAX_RADIUS + 1)",
					"minX = centerX",
					"maxX = centerX",
					"minZ = centerZ",
					"maxZ = centerZ",
				")",
				"if (hasAt(centerX, layer - 1, centerZ):",
					"for (int directions = 2x1111, directions != 0, noop:",
						"random.switch (",
							"if (directions & 2x1000 != 0: hasAll(minX - 1, minZ, minX - 1, maxZ) ? --minX : directions &= 2x0111),",
							"if (directions & 2x0100 != 0: hasAll(maxX + 1, minZ, maxX + 1, maxZ) ? ++maxX : directions &= 2x1011),",
							"if (directions & 2x0010 != 0: hasAll(minX, minZ - 1, maxX, maxZ - 1) ? --minZ : directions &= 2x1101),",
							"if (directions & 2x0001 != 0: hasAll(minX, maxZ + 1, maxX, maxZ + 1) ? ++maxZ : directions &= 2x1110)",
						")",
					")",
					"int*(",
						"sizeX = max(random.nextInt(maxX - minX + 1), random.nextInt(maxX - minX + 1))",
						"sizeZ = max(random.nextInt(maxZ - minZ + 1), random.nextInt(maxZ - minZ + 1))",
					")",
					"random.if (",
						"random.if (maxX = minX + sizeX) else (minX = maxX - sizeX)",
						"minZ = random.nextInt(minZ, maxZ + 1 - sizeZ)",
						"maxZ = minZ + sizeZ",
					")",
					"else (",
						"random.if (maxZ = minZ + sizeZ) else (minZ = maxZ - sizeZ)",
						"minX = random.nextInt(minX, maxX + 1 - sizeX)",
						"maxX = minX + sizeX",
					")",
					"for (int z in range[minZ, maxZ]:",
						"int from = encodeIndex(minX, layer, z)",
						"int to = encodeIndex(maxX, layer, z)",
						"positions.fillBoolean(from, to + 1, true)",
					")",
				")",
			")",
		")",
		"int decodeX(int index: index % MAX_DIAMETER - MAX_RADIUS)",
		"int decodeZ(int index: index / MAX_DIAMETER % MAX_DIAMETER - MAX_RADIUS)",
		"int decodeY(int index: index / MAX_AREA)",
		"NumberArray roofPositions = newBooleanArray(MAX_VOLUME)",
		"boolean hasRoofAt(int*(x, y, z):",
			"roofPositions.(encodeIndex(x, y, z))",
		")",
		"for outer (int index in range[0, MAX_VOLUME):",
			"int*(",
				"rawX = decodeX(index)",
				"rawY = decodeY(index)",
				"rawZ = decodeZ(index)",
			")",
			"for (int*(offsetX, offsetZ) in range[-1, 1]:",
				"unless (hasAt(rawX + offsetX, rawY, rawZ + offsetZ): continue(outer))",
				"if (hasAt(rawX + offsetX, rawY + 1, rawZ + offsetZ): continue(outer))",
			")",
			"roofPositions.(index) = true",
		")",
		"for (int index in range[0, MAX_VOLUME):",
			"int*(",
				"rawX = decodeX(index)",
				"rawY = decodeY(index)",
				"rawZ = decodeZ(index)",
				"x = rawX * 4 + originX",
				"y = rawY * 5 + originY",
				"z = rawZ * 4 + originZ",
			")",
			"if (positions.(index):",
				"pieces.add(",
					"ScriptStructurePiece.new(",
						"-3, 0, -3, 3, 5, 3,",
						"'bigglobe:overworld_fortress',",
						"nbtCompound(",
							"adj: (",
								"int adj = 0",
								"int shift = 0",
								"for (int offsetY in range[0, 1], int*(offsetZ, offsetX) in range[-1, 1]:",
									"adj |= int(hasAt(rawX + offsetX, rawY + offsetY, rawZ + offsetZ)) << ++:shift",
								")",
								"adj",
							")",
						")",
					")",
					".offset(x, y, z)",
				")",
			")",
			"if (roofPositions.(index):",
				"pieces.add(",
					"ScriptStructurePiece.new(",
						"-2, 0, -2, 2, 1, 2,",
						"'bigglobe:grass_roof',",
						"nbtCompound(",
							"adj: (",
								"int adj = 0",
								"int shift = 0",
								"for (int*(offsetZ, offsetX) in range[-1, 1]:",
									"adj |= int(hasRoofAt(rawX + offsetX, rawY, rawZ + offsetZ)) << ++:shift",
								")",
								"adj",
							")",
						")",
					")",
					".offset(x, y + 5, z)",
				")",
			")",
		")"
	]
}