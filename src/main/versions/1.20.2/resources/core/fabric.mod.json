{
	"schemaVersion": 1,
	"id": "bigglobe",
	"version": "${version}",
	"name": "Big Globe",
	"description": "Round earth is a hoax invented by Big Globe to sell more globes!",
	"authors": [
		"Builderb0y"
	],
	"contributors": [
		"Cortex - helped me debug OpenGL issues with my LOD renderer.",
		"Mr Slime - helped with overgrown podzol textures.",
		"hyperix - ukrainian translation.",
		"mpustovoi - russian translation.",
		"Atench - original chinese translation.",
		"AstralArclight9001 - updated chinese translation.",
		"GlinglinMerguez - french translation.",
		"Pastel - korean translation."
	],
	"contact": {
		"issues": "https://github.com/Builderb0y/BigGlobe/issues"
	},
	"license": "CC-BY-NC 4.0",
	"icon": "assets/bigglobe/icon_64x.png",
	"environment": "*",
	"entrypoints": {
		"main":          [ "builderb0y.bigglobe.BigGlobeMod" ],
		"client":        [ "builderb0y.bigglobe.BigGlobeClient" ],
		"server":        [ "builderb0y.bigglobe.BigGlobeServer" ],
		"modmenu":       [ "builderb0y.bigglobe.compat.ModMenuCompat" ],
		"dynamiclights": [ "builderb0y.bigglobe.compat.LambDynamicLightsCompat" ]
	},
	"mixins": [
		"bigglobe.mixins.json"
	],
	"accessWidener": "bigglobe.accesswidener",
	"depends": {
		"fabricloader": ">=0.14.9",
		"fabric-api": "*",
		"minecraft": "1.20.2",
		"java": ">=17"
	},
	"suggests": {
	},
	"recommends": {
		"cloth-config": "*",
		"modmenu": "*"
	},
	"breaks": {
		"wwoo": "*",
		"expanded_ecosphere": "*",
		"terralith": "*"
	}
}