{
	"script": [
		"if (groundReplacements.(getBlockState(originX, originY - 1, originZ).getBlock()) == null: return(false))",
		"float foliage = world_traits.`bigglobe:foliage_at`",
		"double*(",
			"slantAngle = random.nextDouble(tau)",
			"slantRadius = random.nextDouble(0.25L)",
			"x1 = originX + random.nextDouble()",
			"y1 = originY",
			"z1 = originZ + random.nextDouble()",
			"height = min(4.0L - 4.0L * max(foliage, 0.0I) * fastLog2(random.nextDouble()), 24.0L)",
			"x2 = x1 + height * cos(slantAngle) * slantRadius",
			"y2 = y1 + height",
			"z2 = z1 + height * sin(slantAngle) * slantRadius",
			"r1 = height * 0.25L",
		")",
		"tree(",
			"x1, y1, z1, r1,",
			"x2, y2, z2, r1 * 0.75L + 0.25L,",
			"palette,",
			"sqrt(sqrt(height)),",
			"0",
		")",
		"placeTree()",
		"if (!decorations.isEmpty(): placeDecorations())",
		"true"
	],
	"inputs": [
		{
			"name": "palette",
			"type": "WoodPalette"
		},
		{
			"name": "groundReplacements",
			"type": "ConstantMap",
			"default": [
				"ConstantMap.new(",
					"Block('minecraft:grass_block'    ): BlockState('minecraft:dirt'       ),",
					"Block('minecraft:podzol'         ): BlockState('minecraft:dirt'       ),",
					"Block('bigglobe:overgrown_podzol'): BlockState('minecraft:dirt'       ),",
					"Block('minecraft:farmland'       ): BlockState('minecraft:dirt'       ),",
					"Block('minecraft:dirt'           ): BlockState('minecraft:dirt'       ),",
					"Block('minecraft:coarse_dirt'    ): BlockState('minecraft:coarse_dirt'),",
					"Block('minecraft:rooted_dirt'    ): BlockState('minecraft:rooted_dirt'),",
					"Block('minecraft:mud'            ): BlockState('minecraft:mud'        ),",
					"Block('minecraft:packed_mud'     ): BlockState('minecraft:packed_mud' ),",
					"Block('minecraft:sand'           ): BlockState('minecraft:sand'       ),",
					"Block('minecraft:red_sand'       ): BlockState('minecraft:red_sand'   ),",
					"Block('bigglobe:overgrown_sand'  ): BlockState('minecraft:sand'       )",
				")"
			]
		},
		{
			"name": "requireValidGround",
			"type": "boolean"
		},
		{
			"name": "decorations",
			"type": "ConstantMap",
			"default": "ConstantMap.new()"
		}
	],
	"includes": [
		"bigglobe:include/split_tree"
	]
}