{
	"script": [
		"DualSineWaveErosionData result = new(",
			"SineWaveErosionData.new(0.0L, dx, dz),",
			"SineWaveErosionData.new(0.0L, dx, dz),",
			"0.0I",
		")",
		"if (dx != 0.0L || dz != 0.0L:",
			"double mask = 1.0L - 1.0L / ((dx ^ 2 + dz ^ 2) * 2.0L + 1.0L)",
			"class WaveData(double*(value, dx, dz))",
			"WaveData*(",
				"wave00 = new()",
				"wave01 = new()",
				"wave10 = new()",
				"wave11 = new()",
				"mixed  = new()",
			")",
			"double snowLinearFactor = 2.0L",
			"double snowMultiplier = (fastLog2(maxWavelength) - fastLog2(minWavelength)) * snowLinearFactor",
			"for (double scale = maxWavelength, scale >= minWavelength, scale *= 0.5L:",
				"double*(",
					"targetRcp = 1.0L / sqrt(dx ^ 2 + dz ^ 2)",
					"targetX = -dz * targetRcp",
					"targetZ =  dx * targetRcp",
					"coordX  =   x / scale",
					"coordZ  =   z / scale",
				")",
				"int*(",
					"floorCoordX = floorInt(coordX)",
					"floorCoordZ = floorInt(coordZ)",
					"ceilCoordX  = floorCoordX + 1",
					"ceilCoordZ  = floorCoordZ + 1",
				")",
				"double*(",
					"fractCoordX  = coordX - floorCoordX",
					"fractCoordZ  = coordZ - floorCoordZ",
					"smoothCoordX = smooth(fractCoordX)",
					"smoothCoordZ = smooth(fractCoordZ)",
				")",
				"double mixWaveData(double*(corner00, corner01, corner10, corner11):",
					"mixLinear(",
						"mixLinear(corner00, corner01, smoothCoordZ),",
						"mixLinear(corner10, corner11, smoothCoordZ),",
						"smoothCoordX",
					")",
				")",
				"void mixWaveData(:",
					"mixed.value = mixWaveData(wave00.value, wave01.value, wave10.value, wave11.value)",
					"mixed.dx = mixWaveData(wave00.dx, wave01.dx, wave10.dx, wave11.dx)",
					"mixed.dz = mixWaveData(wave00.dz, wave01.dz, wave10.dz, wave11.dz)",
				")",
				"void wave(int*(cornerX, cornerZ), WaveData out:",
					"double*(",
						"projection = (",
							"+ targetX * (coordX - cornerX)",
							"+ targetZ * (coordZ - cornerZ)",
						")",
						"* tau",
						"+ seed.newSeed(cornerX, cornerZ).nextDouble(tau)",
						"cosProjection = fastCos(projection)",
						"sinProjection = fastSin(projection)",
					")",
					"out.value = sinProjection",
					"out.dx = cosProjection * targetX",
					"out.dz = cosProjection * targetZ",
				")",
				"wave(floorCoordX, floorCoordZ, wave00)",
				"wave(floorCoordX,  ceilCoordZ, wave01)",
				"wave( ceilCoordX, floorCoordZ, wave10)",
				"wave( ceilCoordX,  ceilCoordZ, wave11)",
				"mixWaveData()",
				"result.terrain.y += mixed.value * mask * scale",
				"result.snow.y += mixed.value * mask * (scale - snowMultiplier * minWavelength)",
				"result.foliage += float(mixed.value * mask)",
				"dx += mixed.dx * mask",
				"dz += mixed.dz * mask",
				"mask *= sqrt(1.0 - mixed.value ^ 2)",
				"snowMultiplier -= snowLinearFactor",
			")",
			"double factor = amplitude / maxWavelength",
			"result.terrain.y *= factor",
			"result.terrain.dx = dx",
			"result.terrain.dz = dz",
			"result.snow.y *= factor",
			"result.snow.dx = dx",
			"result.snow.dz = dz",
		")",
		"result.terrain.y += highY",
		"result.snow.y += lowY",
		"return(result)"
	],
	"inputs": [
		{ "name": "lowY",          "type": "double", "default": "0.0L" },
		{ "name": "highY",         "type": "double", "default": "0.0L" },
		{ "name": "dx",            "type": "double" },
		{ "name": "dz",            "type": "double" },
		{ "name": "minWavelength", "type": "double" },
		{ "name": "maxWavelength", "type": "double" },
		{ "name": "amplitude",     "type": "double" },
		{ "name": "seed",          "type": "long"   }
	]
}