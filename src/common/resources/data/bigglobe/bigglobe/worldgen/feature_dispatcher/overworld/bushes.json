{
	"type": "script",
	"dispatcher": [
		"repeat (random.roundInt(max(world_traits.`bigglobe:foliage_at_surface`(minModifiableX | 8, minModifiableZ | 8) + 0.25I, 0.0I) ^ 2 * 8.0I):",
			"int*(",
				"rng = random.nextInt()",
				"x = minModifiableX | (rng & 15)",
				"z = minModifiableZ | ((rng >>> 4) & 15)",
			")",
			"if (!world_traits.`bigglobe:in_river`(x, z) && `bigglobe:overworld/surface_states_override`(x, z) == null:",
				"int y = world_traits.`bigglobe:y_level_on_surface`(x, z)",
				"placeFeature(x, y, z, 'bigglobe:overworld/bush')",
			")",
		")"
	]
}