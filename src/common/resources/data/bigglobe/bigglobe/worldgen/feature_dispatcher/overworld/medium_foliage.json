{
	"type": "script",
	"dispatcher": [
		"for (",
			"int z in range[minModifiableZ, maxModifiableZ],",
			"int x in range[minModifiableX, maxModifiableX]",
		":",
			"int y = world_traits.`bigglobe:y_level_on_surface`(x, z)",
			"EnabledDecorations decorations = world_traits.`bigglobe:enabled_decorations`(x, y, z)",
			"if (y < world_traits.`bigglobe:sea_level`(x, z):",
				"random.if (0.0625L / (fastExp(-4.0L * world_traits.`bigglobe:foliage_at_surface`(x, z)) + 1.0L):",
					"placeFeature(x, y, z, 'bigglobe:overworld/kelp')",
				")",
			")",
			"else if (world_traits.`bigglobe:is_desert`(x, z):",
				"if (",
					"decorations.hotFoliage && random.nextBoolean(",
						"0.00390625L / (fastExp(-4.0L * world_traits.`bigglobe:foliage_at_surface`(x, z)) + 1.0L)",
					")",
				":",
					"placeFeature(x, y, z, 'bigglobe:overworld/cactus')",
				")",
			")",
			"else if (",
				"decorations.grassyFoliage &&",
				"!random.nextBoolean(world_traits.`bigglobe:snow_chance_at`(x, y, z)) &&",
				"random.nextBoolean(max(world_traits.`bigglobe:foliage_at_surface`(x, z), 0.0I) ^ 2 * 0.125I)",
			":",
				"placeFeature(x, y, z, 'bigglobe:overworld/bamboo')",
			")",
		")"
	]
}