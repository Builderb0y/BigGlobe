{
	"type": "script",
	"dispatcher": [
		"for (",
			"int z in range[minModifiableZ, maxModifiableZ],",
			"int x in range[minModifiableX, maxModifiableX]",
		":",
			"if (",
				"world_traits.`bigglobe:y_level_on_surface`(x, z) <= floorInt(`bigglobe:overworld/glacier_max_y`(x, z)) &&",
				"`bigglobe:overworld/glacier_cell`(x, z).?hardDistance ?: 1.0L <= `bigglobe:overworld/glacier_crack_threshold`(x, z)",
			":",
				"placeFeature(x, 0, z, 'bigglobe:overworld/glacier')",
			")",
		")"
	]
}