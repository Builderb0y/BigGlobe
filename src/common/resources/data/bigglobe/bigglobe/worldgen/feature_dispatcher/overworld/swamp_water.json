{
	"type": "bigglobe:script",
	"dispatcher": [
		"repeat (random.roundInt(",
			"max(0.0I, world_traits.`bigglobe:humidity_at_surface`(minModifiableX | 8, minModifiableZ | 8)) *",
			"(0.25I - max(0.0I, world_traits.`bigglobe:magicalness`(minModifiableX | 8, minModifiableZ | 8))) *",
			"16.0I",
		"):",
			"int*(",
				"x = minModifiableX | random.nextInt(16)",
				"z = minModifiableZ | random.nextInt(16)",
				"y = world_traits.`bigglobe:y_level_in_surface`(x, z)",
			")",
			"if (`bigglobe:overworld/surface_states_override`(x, z) == null:",
				"placeFeature(x, y, z, 'bigglobe:overworld/swamp_water')",
			")",
		")"
	]
}