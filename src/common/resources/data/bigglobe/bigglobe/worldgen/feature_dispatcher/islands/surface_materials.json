{
	"type": "script",
	"dispatcher": [
		";rocks",
		"repeat (64:",
			"int x = random.nextBetween[minModifiableX, maxModifiableX]",
			"int z = random.nextBetween[minModifiableZ, maxModifiableZ]",
			"random.unless (1.0L / (world_traits.`bigglobe:hilliness`(x, z) + 1.0L):",
				"int y = world_traits.`bigglobe:y_level_on_surface`(x, z)",
				"placeFeature(x, y, z, 'bigglobe:overworld/rock')",
			")",
		")",

		";flint",
		"random.if (0.25I:",
			"int x = random.nextBetween[minModifiableX, maxModifiableX]",
			"int z = random.nextBetween[minModifiableZ, maxModifiableZ]",
			"int y = world_traits.`bigglobe:y_level_on_surface`(x, z)",
			"placeFeature(x, y, z, 'bigglobe:overworld/flint')",
		")",

		";sticks",
		"repeat (random.roundInt(world_traits.`bigglobe:foliage_at_surface`(minModifiableX | 8, minModifiableZ | 8) * 16.0L):",
			"int x = random.nextBetween[minModifiableX, maxModifiableX]",
			"int z = random.nextBetween[minModifiableZ, maxModifiableZ]",
			"int y = world_traits.`bigglobe:y_level_on_surface`(x, z)",
			"if (world_traits.`bigglobe:enabled_decorations`(x, y, z).grassyFoliage:",
				"placeFeature(x, y, z, 'bigglobe:overworld/stick')",
			")",
		")"
	]
}