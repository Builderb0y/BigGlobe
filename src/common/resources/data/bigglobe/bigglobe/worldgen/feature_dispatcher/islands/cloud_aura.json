{
	"type": "script",
	"dispatcher": [
		"if (`bigglobe:islands/type`(minModifiableX, minModifiableZ).is(FloatingIslandType):",
			"VoronoiCell cell = `bigglobe:islands/island_voronoi`(minModifiableX, minModifiableZ)",
			"for (",
				"int z in range[minModifiableZ, maxModifiableZ],",
				"int x in range[minModifiableX, maxModifiableX]",
			":",
				"int y = floorInt(random.nextDouble(",
					"`bigglobe:islands/clouds/y_offset`(x, z) - 64.0L,",
					"`bigglobe:islands/clouds/y_offset`(x, z) + 64.0L",
				"))",
				"if (getBlockState(x, y, z) ==. 'bigglobe:cloud':",
					"setBlockState(x, y, z,",
						"random.nextBoolean(0.125I)",
						"? 'bigglobe:omni_aura_infused_cloud'",
						": switch (floorInt(atan2(x - cell.centerX, z - cell.centerZ) * (`bigglobe:islands/clouds/ring_index`(x, z) * (64.0L / tau)) + random.nextDouble()) % 12:",
							"case ( 0: 'bigglobe:red_aura_infused_cloud')",
							"case ( 1: 'bigglobe:orange_aura_infused_cloud')",
							"case ( 2: 'bigglobe:yellow_aura_infused_cloud')",
							"case ( 3: 'bigglobe:yellow_green_aura_infused_cloud')",
							"case ( 4: 'bigglobe:green_aura_infused_cloud')",
							"case ( 5: 'bigglobe:cyan_green_aura_infused_cloud')",
							"case ( 6: 'bigglobe:cyan_aura_infused_cloud')",
							"case ( 7: 'bigglobe:cyan_blue_aura_infused_cloud')",
							"case ( 8: 'bigglobe:blue_aura_infused_cloud')",
							"case ( 9: 'bigglobe:purple_aura_infused_cloud')",
							"case (10: 'bigglobe:magenta_aura_infused_cloud')",
							"case (11: 'bigglobe:magenta_red_aura_infused_cloud')",
							"default ('bigglobe:cloud')",
						")",
					")",
				")",
			")",
		")"
	]
}