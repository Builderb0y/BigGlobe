{
	"type": "script",
	"dispatcher": [
		"repeat (4:",
			"int*(",
				"rng = random.nextInt()",
				"x = minModifiableX | (rng & 15)",
				"z = minModifiableZ | ((rng >>> 4) & 15)",
			")",
			"if (",
				"world_traits.`bigglobe:foliage_at_surface`(x, z) > 0.0I &&",
				"!world_traits.`bigglobe:in_river`(x, z) &&",
				"`bigglobe:overworld/surface_states_override`(x, z) == null",
			":",
				"ConfiguredFeature feature = `bigglobe:overworld/foliage_feature`(x, z)",
				"if (feature != null:",
					"int y = world_traits.`bigglobe:y_level_on_surface`(x, z)",
					"placeFeature(x, y, z, feature)",
				")",
			")",
		")"
	]
}