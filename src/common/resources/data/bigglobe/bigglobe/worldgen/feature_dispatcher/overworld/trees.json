{
	"type": "script",
	"dispatcher": [
		"repeat (4:",
			"int*(",
				"rng = random.nextInt()",
				"x = random.nextBetween[minModifiableX, maxModifiableX]",
				"z = random.nextBetween[minModifiableZ, maxModifiableZ]",
				"y = world_traits.`bigglobe:y_level_on_surface`(x, z)",
			")",
			"if (",
				"world_traits.`bigglobe:enabled_decorations`(x, y, z).grassyFoliage &&",
				"world_traits.`bigglobe:foliage_at_surface`(x, z) > 0.0I &&",
				"`bigglobe:overworld/surface_states_override`(x, z) == null",
			":",
				"ConfiguredFeature feature = world_traits.`bigglobe:wood_palette`(x, z).?features.?('natural_surface')",
				"if (feature != null:",
					"placeFeature(x, y, z, feature)",
				")",
			")",
		")"
	]
}