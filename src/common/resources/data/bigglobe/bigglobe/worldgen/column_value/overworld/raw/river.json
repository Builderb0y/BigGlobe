{
	"type": "script",
	"params": {
		"type": "double",
		"is_3d": false
	},
	"script": [
		"double slope = sqrt(`river/dx_macro` ^ 2 + `river/dz_macro` ^ 2) * 1024.0L",
		"double curve(double value:",
			"1.0L - 1.0L / ((value / slope) ^ 4 + 1.0L)",
		")",
		"double*(",
			"h = heightmap",
			"h2 = h ^ 2",
			"hOffset = h - 16.0L",
			"widthFade = hOffset / sqrt(hOffset ^ 2 + 1024.0L) * 0.5L + 0.5L",
			"depth = 8192.0L / (h2 + 512.0L) + (4.0L * h) / sqrt(h2 + 128.0L) + 4.0L",
			"macro = `river/macro`",
			"result = depth",
		")",
		"result *= curve((macro * (1.0L / 0.24L) + `river/micro_1`) * 64.0L * widthFade)",
		"result *= curve((macro * (1.0L / 0.24L) + `river/micro_2`) * 32.0L * widthFade)",
		"result *= curve((macro * (1.0L / 0.24L) + `river/micro_3`) * 32.0L * widthFade)",
		"result *= curve((macro * (1.0L / 0.24L) + `river/micro_4`) * 16.0L * widthFade)",
		"return(result + `river/bottom_noise` * unmixSmooth(6.0L, 0.0L, result) - depth)"
	]
}