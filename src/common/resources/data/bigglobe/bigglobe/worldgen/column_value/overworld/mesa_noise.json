{
	"type": "bigglobe:noise",
	"params": {
		"type": "float",
		"is_3d": false
	},
	"grid": {
		"type": "sum",
		"layers": [
			{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 0.5      }, "scale": 2048 },
			{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 0.25     }, "scale": 1024 },
			{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 0.125    }, "scale":  512 },
			{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 0.0625   }, "scale":  256 },
			{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 0.03125  }, "scale":  128 },
			{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 0.015625 }, "scale":   64 }
		]
	}
}