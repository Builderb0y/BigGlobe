{
	"type": "noise",
	"params": {
		"type": "float",
		"is_3d": false
	},
	"grid": {
		"type": "script",
		"min": -0.0625,
		"max":  0.0625,
		"script": [
			"0.0625L * base / sqrt(base ^ 2 + 1.0L)"
		],
		"inputs": {
			"base": {
				"type": "sum",
				"layers": [
					{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 4.0 }, "scale": 128 },
					{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 2.0 }, "scale":  64 },
					{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 1.0 }, "scale":  32 }
				]
			}
		}
	}
}