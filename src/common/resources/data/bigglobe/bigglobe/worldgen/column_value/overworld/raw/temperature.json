			{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 0.03125   }, "scale":  256 },
			{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 0.015625  }, "scale":  128 },
			{ "type": "smooth_resample", "source": { "type": "binary", "amplitude": 0.0078125 }, "scale":   64 }
