{
	"type": "script",
	"params": {
		"type": "float",
		"is_3d": true
	},
	"script": [
		"float fraction = (",
			"unmixLinear(",
				"world_traits.`bigglobe:core_min_y`.as(double),",
				"world_traits.`bigglobe:core_max_y`.as(double),",
				"y.as(double)",
			")",
			".as(float) * 2.0I - 1.0I",
		")",
		"return(",
			"raw_core_noise + (",
				"fraction * 0.125I + fraction ^ 16 * 0.75I",
			")",
		")"
	],
	"valid": {
		"min_y": "world_traits.`bigglobe:core_min_y`",
		"max_y": "world_traits.`bigglobe:core_max_y`"
	}
}