{
	"type": "simple_3d",
	"state": "'minecraft:air'",
	"condition": "world_traits.`bigglobe:nether_bubble_noise` < 0.5I",
	"valid": {
		"min_y": "`bigglobe:nether/min_y` + 16",
		"max_y": "`bigglobe:nether/max_y` - 16"
	},
	"after_children": {
		"includes": [
			"bigglobe:world_preset/place_surface",
			"bigglobe:world_preset/place_surface_above"
		],
		"source": [
			"if (`bigglobe:nether/is_center`:",
				"NetherBubble bubble = `bigglobe:nether/bubble_type`",
				"int minIteration = `bigglobe:nether/min_y`",
				"int maxIteration = `bigglobe:nether/max_y`",
				"int y = minIteration",
				"while (y <= maxIteration:",
					"int nextY = getTopOfSegment(y)",
					"unless (getBlockState(y - 1).?isReplaceable() ?: false:",
						"int ceilingY = nextY",
						"nextY = getTopOfSegment(nextY)",
						"placeSurface(y, bubble.surface(column, y).floor)",
						"placeSurfaceAbove(ceilingY, bubble.surface(column, ceilingY).ceiling)",
					")",
					"y = nextY",
				")",
			")"
		]
	},
	"children": [
		"bigglobe:nether/lava_ocean"
	]
}