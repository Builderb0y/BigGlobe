	"script": [
		"BlockState getState(int fakeY:",
			"`bigglobe:overworld/rocks/filler`(fakeY)",
		")",
		"void fillAuto(int*(minFillY, maxFillY):",
			"BlockState prevState = getState(minFillY)",
			"int prevY = minFillY",
			"for (int y in range[minFillY, maxFillY):",
				"BlockState nextState = getState(y)",
				"if (nextState != prevState:",
					"setBlockStates(prevY, y, prevState)",
					"prevY = y",
					"prevState = nextState",
				")",
			")",
			"setBlockStates(prevY, maxFillY, prevState)",
		")",
		"if (hints.isLod:",
			"if (hints.carve:",
				"fillAuto(world_traits.`bigglobe:min_y`, world_traits.`bigglobe:core_max_y`)",
				"setBlockStates(world_traits.`bigglobe:core_max_y`, world_traits.`bigglobe:deep_dark_max_y`, 'bigglobe:darkslate[axis=y]')",
				"setBlockStates(world_traits.`bigglobe:deep_dark_max_y`, world_traits.`bigglobe:chasm_max_y`, 'minecraft:deepslate[axis=y]')",
				"setBlockStates(world_traits.`bigglobe:chasm_max_y`, world_traits.`bigglobe:y_level_on_surface`, getState(world_traits.`bigglobe:y_level_in_surface`))",
			")",
			"else (",
				"setBlockStates(world_traits.`bigglobe:min_y`, world_traits.`bigglobe:y_level_on_surface`, getState(world_traits.`bigglobe:y_level_in_surface`))",
			")",
		")",
		"else (",
			"fillAuto(world_traits.`bigglobe:min_y`, world_traits.`bigglobe:y_level_on_surface`)",
		")"
	],
	"after_children": {
