{
	"type": "structure",
	"script": [
		"if (start.structure ==. 'minecraft:bastion_remnant':",
			"int midX = start.midX",
			"int midZ = start.midZ",
			"if (`bigglobe:nether/bubble`(midX, midZ).softDistanceSquared > 0.5: return(false))",
			"NetherBubble bubble = `bigglobe:nether/bubble_type`(midX, midZ)",
			"start.move(bubble.lavaLevel - start.minY)",
		")",
		"return(true)"
	]
}