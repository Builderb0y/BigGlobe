{
	"dimensions": 3,
	"type": "script",
	"min": -3.0,
	"max":  1.0,
	"script": [
		"double h2 = horizontal ^ 2",
		"double v2 = vertical   ^ 2",
		"return(sqrt(sqrt((h2 + fastExp2(-v2) * 0.9375L + 0.0625L) / (h2 + 1.0L))) * 4.0L - 3.0L)"
	],
	"inputs": {
		"horizontal": {
			"type": "smooth_resample",
			"source": { "type": "binary", "amplitude": 2.0 },
			"scaleX": 64,
			"scaleY": 16,
			"scaleZ": 64
		},
		"vertical": {
			"type": "smooth_resample",
			"source": { "type": "binary", "amplitude": 4.0 },
			"scaleX": 64,
			"scaleY": 128,
			"scaleZ": 64
		}
	}
}