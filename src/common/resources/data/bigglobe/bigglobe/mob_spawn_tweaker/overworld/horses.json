{
	"primary_entity": "minecraft:horse",
	"script": [
		"float*(",
			"temperature = world_traits.`bigglobe:temperature_at`",
			"foliage = world_traits.`bigglobe:foliage_at`",
			"horseWeight = max(-foliage, 0.0I) / sqrt(foliage ^ 2 + 0.0625I).as(float) * max(1.0I - (temperature * 8.0I) ^ 2, 0.0I) ^ 2",
		")",
		"spawnMap.('minecraft:horse').=$weight(horseWeight * 2.0I).=$count(random.nextBetween[1, 3])",
		"spawnMap.('minecraft:donkey').=$weight(horseWeight).=$count(random.nextBetween[1, 2])"
	]
}