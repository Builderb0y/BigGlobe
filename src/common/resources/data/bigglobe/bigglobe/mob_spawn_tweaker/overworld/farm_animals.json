{
	"primary_entity": "minecraft:pig",
	"script": [
		"float*(",
			"temperature = world_traits.`bigglobe:temperature_at`",
			"farmWeight = 1.0I / ((temperature * 8.0I) ^ 2 + 1.0I)",
		")",
		"spawnMap.('minecraft:pig').=$weight(farmWeight).=$count(random.nextBetween[1, 4])",
		"spawnMap.('minecraft:sheep').=$weight(farmWeight).=$count(random.nextBetween[1, 4])",
		"spawnMap.('minecraft:cow').=$weight(farmWeight).=$count(random.nextBetween[1, 4])",
		"spawnMap.('minecraft:chicken').=$weight(farmWeight).=$count(random.nextBetween[1, 4])"
	]
}