{
	"element_type": "method/static",
	"owner": "bigglobe:rock_stripes/base/class",
	"name": "getStripe",
	"return_type": "block_state",
	"parameters": [
		{ "name": "column", "type": "column_storage", "import": true },
		{ "name": "y", "type": "int" },
		{ "name": "terracottaOffset", "type": "double" },
		{ "name": "choices", "type": "set" }
	],
	"code": [
		"BlockState state = null",
		"double surfaceY = world_traits.`bigglobe:exact_surface_y`",
		"if (choices != null && (worldSeed # 16x3776AAB989CB90D6UL).newSeed(y).nextBoolean(unmixSmooth(double(surfaceY - 32), double(surfaceY - 16), double(y))):",
			"int seedY = y + floorInt(terracottaOffset)",
			"long seed = (worldSeed # 16x1D1BD7A23A42B200UL).newSeed(seedY)",
			"float totalWeight = 0.0I",
			"for (RockStripe stripe in choices:",
				"if ((seed := seed.newSeed()).nextFloat(totalWeight :+ stripe.weight) < stripe.weight:",
					"state = stripe.state",
				")",
			")",
		")",
		"return(state)"
	]
}