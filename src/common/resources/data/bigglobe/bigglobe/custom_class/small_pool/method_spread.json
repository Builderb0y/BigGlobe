{
	"element_type": "method/normal",
	"owner": "bigglobe:small_pool/class",
	"name": "spread",
	"return_type": "boolean",
	"parameters": [
		{ "name": "world", "type": "world", "import": true },
		{ "name": "originX", "type": "int" },
		{ "name": "originY", "type": "int" },
		{ "name": "originZ", "type": "int" }
	],
	"code": [
		"boolean checkBelow(int*(x, z):",
			"getBlockState(x, originY,     z).isIn(this.groundReplaceable) &&",
			"getBlockState(x, originY - 1, z).isIn(this.groundReplaceable)",
		")",
		"boolean checkAbove(int*(x, z):",
			"BlockState state = getBlockState(x, originY + 1, z)",
			"state.isReplaceable() || state.isIn('#bigglobe:plants')",
		")",
		"unless (checkBelow(originX, originZ) && checkAbove(originX, originZ): return(false))",
		"HashSet seen = new()",
		"ColumnPos first = ColumnPos.at(originX, originZ)",
		"this.surroundingColumns.add(first)",
		"seen.add(first)",
		"repeat (random.nextBetween[16, 64]:",
			"int size = this.surroundingColumns.size()",
			"if (size == 0: break())",
			"int index = random.nextInt(size)",
			"ColumnPos column = this.surroundingColumns.(index)",
			"int*(x = column.x, z = column.z)",
			"if (",
				"checkBelow(x - 1, z) &&",
				"checkBelow(x + 1, z) &&",
				"checkBelow(x, z - 1) &&",
				"checkBelow(x, z + 1) &&",
				"checkAbove(x, z)",
			":",
				"if (index == size - 1: this.surroundingColumns.removeIndex(index))",
				"else (this.surroundingColumns.set(index, this.surroundingColumns.removeIndex(size - 1)))",
				"this.fluidColumns.add(column)",
				"ColumnPos adjacent = null",
				"if (seen.add(adjacent := ColumnPos.at(x + 1, z)): this.surroundingColumns.add(adjacent))",
				"if (seen.add(adjacent := ColumnPos.at(x - 1, z)): this.surroundingColumns.add(adjacent))",
				"if (seen.add(adjacent := ColumnPos.at(x, z + 1)): this.surroundingColumns.add(adjacent))",
				"if (seen.add(adjacent := ColumnPos.at(x, z - 1)): this.surroundingColumns.add(adjacent))",
			")",
		")",
		"return(true)"
	]
}