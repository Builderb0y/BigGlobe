{
	"element_type": "method/normal",
	"owner": "bigglobe:eroder/class",
	"name": "erode",
	"return_type": "void",
	"parameters": [
		{ "name": "waveScale",     "type": "double" },
		{ "name": "waveAmplitude", "type": "double" }
	],
	"code": [
		"double*(",
			"targetRcp = 1.0L / sqrt(dx ^ 2 + dz ^ 2)",
			"targetX = -dz * targetRcp",
			"targetZ =  dx * targetRcp",
			"coordX  =   x / waveScale",
			"coordZ  =   z / waveScale",
		")",
		"int*(",
			"floorCoordX = floorInt(coordX)",
			"floorCoordZ = floorInt(coordZ)",
			"ceilCoordX  = floorCoordX + 1",
			"ceilCoordZ  = floorCoordZ + 1",
		")",
		"double*(",
			"fractCoordX  = coordX - floorCoordX",
			"fractCoordZ  = coordZ - floorCoordZ",
			"smoothCoordX = smooth(fractCoordX)",
			"smoothCoordZ = smooth(fractCoordZ)",
		")",
		"double project(int*(cornerX, cornerZ):",
			"(",
				"+ targetX * (coordX - cornerX)",
				"+ targetZ * (coordZ - cornerZ)",
			")",
			"* tau",
			"+ seed.newSeed(cornerX, cornerZ).nextDouble(tau)",
		")",
		"double*(",
			"projection00 = project(floorCoordX, floorCoordZ),",
			"projection01 = project(floorCoordX,  ceilCoordZ),",
			"projection10 = project( ceilCoordX, floorCoordZ),",
			"projection11 = project( ceilCoordX,  ceilCoordZ),",
			"value00 = fastSin(projection00),",
			"value01 = fastSin(projection01),",
			"value10 = fastSin(projection10),",
			"value11 = fastSin(projection11),",
			"cos00 = fastCos(projection00),",
			"cos01 = fastCos(projection01),",
			"cos10 = fastCos(projection10),",
			"cos11 = fastCos(projection11),",
			"dx00 = cos00 * targetX,",
			"dx01 = cos01 * targetX,",
			"dx10 = cos10 * targetX,",
			"dx11 = cos11 * targetX,",
			"dz00 = cos00 * targetZ",
			"dz01 = cos01 * targetZ",
			"dz10 = cos10 * targetZ",
			"dz11 = cos11 * targetZ",
			"",
			"waveValue = mixLinear(",
				"mixLinear(value00, value01, smoothCoordZ),",
				"mixLinear(value10, value11, smoothCoordZ),",
				"smoothCoordX",
			")",
			"waveDx = mixLinear(",
				"mixLinear(dx00, dx01, smoothCoordZ),",
				"mixLinear(dx10, dx11, smoothCoordZ),",
				"smoothCoordX",
			")",
			"waveDz = mixLinear(",
				"mixLinear(dz00, dz01, smoothCoordZ),",
				"mixLinear(dz10, dz11, smoothCoordZ),",
				"smoothCoordX",
			")",
		")",
		"y += waveValue * mask * waveAmplitude",
		"dx += waveDx * mask",
		"dz += waveDz * mask",
		"mask *= sqrt(1.0L - waveValue ^ 2)"
	]
}