{
	"element_type": "method/static",
	"owner": "bigglobe:derivative1d/class",
	"name": "unmixLinear",
	"return_type": "bigglobe:derivative1d/class",
	"parameters": [
		{ "name": "min", "type": "bigglobe:derivative1d/class" },
		{ "name": "max", "type": "bigglobe:derivative1d/class" },
		{ "name": "factor", "type": "bigglobe:derivative1d/class" }
	],
	"code": [
		"double value = unmixLinear(min.value, max.value, factor.value)",
		"double dx = (factor.dx - min.dx) / (max.value - min.value) - ((factor.value - min.value) * (max.dx - min.dx)) / (max.value - min.value) ^ 2",
		"return(Derivative1D.variable(value, dx))"
	]
}