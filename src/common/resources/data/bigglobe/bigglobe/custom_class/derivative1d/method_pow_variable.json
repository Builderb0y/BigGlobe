{
	"element_type": "method/normal",
	"owner": "bigglobe:derivative1d/class",
	"name": "pow",
	"return_type": "void",
	"parameters": [
		{ "name": "value", "type": "double" },
		{ "name": "dx",    "type": "double" }
	],
	"code": [
		"double newValue = this.value ^ value",
		"double newDx = newValue * (value * this.dx / this.value + ln(this.value) * dx)",
		"this.value = newValue",
		"this.dx = newDx"
	]
}