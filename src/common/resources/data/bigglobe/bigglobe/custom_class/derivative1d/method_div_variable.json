{
	"element_type": "method/normal",
	"owner": "bigglobe:derivative1d/class",
	"name": "div",
	"return_type": "void",
	"parameters": [
		{ "name": "value", "type": "double" },
		{ "name": "dx",    "type": "double" }
	],
	"code": [
		"double newValue = this.value / value",
		"double newDx = (value * this.dx - this.value * dx) / value ^ 2",
		"this.value = newValue",
		"this.dx = newDx"
	]
}