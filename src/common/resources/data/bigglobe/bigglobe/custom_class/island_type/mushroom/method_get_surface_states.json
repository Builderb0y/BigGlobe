{
	"element_type": "method/override",
	"owner": "bigglobe:island_type/mushroom/class",
	"override": "bigglobe:island_type/base/method_get_surface_states",
	"code": [
		"int depth = floorInt(`bigglobe:islands/default_surface_depth`)",
		"SurfaceStates result = SurfaceStates.new()",
		"if (depth > 1: result.add('minecraft:dirt', depth))",
		"if (depth > 0: result.add('minecraft:mycelium[snowy=false]', 1))",
		"return(result)"
	]
}