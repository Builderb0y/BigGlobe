{
	"element_type": "method/override",
	"owner": "bigglobe:island_type/forest/class",
	"override": "bigglobe:island_type/base/method_get_surface_y_gradient",
	"code": [
		"Derivative2D base = `bigglobe:islands/type_storage/beach_shape`",
		"if (base.value > 0.0L:",
			"IslandType.erode(",
				"Eroder.new(),",
				"column,",
				"base,",
				"4.0L,",
				"256.0L,",
				"64.0L * (1.0L - 1024.0L / (base.value ^ 2 + 1024.0L))",
			")",
		")",
		"else(",
			"base",
		")"
	]
}