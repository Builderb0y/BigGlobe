{
	"element_type": "method/normal",
	"owner": "bigglobe:derivative3d/class",
	"name": "pow",
	"return_type": "void",
	"parameters": [
		{ "name": "value", "type": "double" }
	],
	"code": [
		"double newValue = this.value ^ value",
		"double newDx = this.value ^ (value - 1.0L) * value * this.dx",
		"double newDy = this.value ^ (value - 1.0L) * value * this.dy",
		"double newDz = this.value ^ (value - 1.0L) * value * this.dz",
		"this.value = newValue",
		"this.dx = newDx",
		"this.dy = newDy",
		"this.dz = newDz"
	]
}