{
	"element_type": "method/normal",
	"owner": "bigglobe:derivative3d/class",
	"name": "smooth",
	"return_type": "void",
	"parameters": [],
	"code": [
		"if (this.value <= 0.0L:",
			"this.value = 0.0L",
			"this.dx = 0.0L",
			"this.dy = 0.0L",
			"this.dz = 0.0L",
		")",
		"else if (this.value >= 1.0L:",
			"this.value = 1.0L",
			"this.dx = 0.0L",
			"this.dy = 0.0L",
			"this.dz = 0.0L",
		")",
		"else (",
			"double newValue = this.value ^ 2 * (3.0L - 2.0L * this.value)",
			"double common = 6.0L * this.value * (1.0L - this.value)",
			"double newDx = common * this.dx",
			"double newDy = common * this.dy",
			"double newDz = common * this.dz",
			"this.value = newValue",
			"this.dx = newDx",
			"this.dy = newDy",
			"this.dz = newDz",
		")"
	]
}