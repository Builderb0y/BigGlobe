{
	"element_type": "method/static",
	"owner": "bigglobe:rock_fillers/base/class",
	"name": "choose",
	"return_type": "block_state",
	"parameters": [
		{ "type": "bigglobe:column_storage", "name": "column", "import": true },
		{ "type": "int", "name": "y" }
	],
	"code": [
		"float maxWeight = -1000.0I",
		"BlockState state = 'minecraft:stone'",
		"for (RockFiller filler in RockFiller.valueSet:",
			"float weight = filler.weight(column, y)",
			"if (weight > maxWeight:",
				"state = filler.state",
				"maxWeight = weight",
			")",
		")",
		"return(state)"
	]
}