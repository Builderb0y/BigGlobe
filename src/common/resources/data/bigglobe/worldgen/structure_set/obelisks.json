{
	"placement": {
		"type": "bigglobe:scripted",
		"placement": [
			"for (",
				"int regionZ in range[(centerChunkZ - chunkRange) / 512, (centerChunkZ + chunkRange) / 512],",
				"int regionX in range[(centerChunkX - chunkRange) / 512, (centerChunkX + chunkRange) / 512]",
			":",
				"int blockX  = regionX * 8192",
				"int blockZ  = regionZ * 8192",
				"int count   = `bigglobe:overworld/obelisk_group_count`(blockX, blockZ)",
				"int centerX = `bigglobe:overworld/obelisk_group_center_x`(blockX, blockZ)",
				"int centerZ = `bigglobe:overworld/obelisk_group_center_z`(blockX, blockZ)",
				"double startAngle = `bigglobe:overworld/obelisk_group_angle`(blockX, blockZ)",
				"double radius = `bigglobe:overworld/obelisk_group_radius`(blockX, blockZ)",
				"for (int index in range[0, count):",
					"double angle = double(index) / double(count) * tau + startAngle",
					"int newX = centerX + int(cos(angle) * radius)",
					"int newZ = centerZ + int(sin(angle) * radius)",
					"addStart(newX / 16, newZ / 16)",
				")",
			")"
		]
	},
	"structures": [
		{ "structure": "bigglobe:obelisk", "weight": 1 }
	]
}