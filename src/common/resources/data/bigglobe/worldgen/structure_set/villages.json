{
	"placement": {
		"type": "bigglobe:script",
		"script": [
			"int spacing = 24 * 16",
			"int separation = 8 * 16",
			"int variation = spacing - separation",
			"for (",
				"int regionZ in range[regionMinZ / spacing, regionMaxZ / spacing],",
				"int regionX in range[regionMinX / spacing, regionMaxX / spacing]",
			":",
				"int centerX = regionX * spacing + (worldSeed # 16x3B72AAD4DF0FF842UL).newSeed(regionX, regionZ).nextInt(variation)",
				"int centerZ = regionZ * spacing + (worldSeed # 16x0BC94D4787E908A6UL).newSeed(regionX, regionZ).nextInt(variation)",
				"unless (world_traits.`bigglobe:is_beach`(centerX, centerZ):",
					"int centerY = world_traits.`bigglobe:y_level_on_surface`(centerX, centerZ)",
					"WoodPalette palette = world_traits.`bigglobe:wood_palette`(centerX, centerY, centerZ)",
					"Structure structure = (",
						"if (palette == null:",
							"world_traits.`bigglobe:is_desert`(centerX, centerZ) &&",
							"!world_traits.`bigglobe:is_mesa`(centerX, centerZ)",
							"? 'bigglobe:vanilla/village_desert'",
							": null",
						")",
						"else if (palette ==. 'minecraft:acacia': 'bigglobe:vanilla/village_savanna')",
						"else if (palette ==. 'minecraft:oak': 'bigglobe:vanilla/village_plains')",
						"else if (palette ==. 'minecraft:spruce' || palette ==. 'minecraft:dark_oak':",
							"(worldSeed # 16x86B1F21AECC2626DUL).newSeed(centerX, centerY, centerZ).nextBoolean()",
							"? 'bigglobe:vanilla/village_snowy'",
							": 'bigglobe:vanilla/village_taiga'",
						")",
						"else (null)",
					")",
					"if (structure != null:",
						"StructureStart start = createStartNear(centerX, centerY, centerZ, structure)",
						"if (start.?override(): starts.add(start))",
					")",
				")",
			")"
		]
	},
	"structures": [
		{ "weight": 1, "structure": "bigglobe:vanilla/village_desert"  },
		{ "weight": 1, "structure": "bigglobe:vanilla/village_savanna" },
		{ "weight": 1, "structure": "bigglobe:vanilla/village_plains"  },
		{ "weight": 1, "structure": "bigglobe:vanilla/village_snowy"   },
		{ "weight": 1, "structure": "bigglobe:vanilla/village_taiga"   }
	]
}