{
	"type": "bigglobe:script",
	"config": {
		"script": [
			"unless (random.nextBoolean(0.25): return(false))",
			"int y = 0",
			"while (--y,, random.nextBoolean() && getBlockState(0, y, 0).isAir():",
				"setBlockState(0, y, 0, 'minecraft:pale_hanging_moss[tip=false]')",
			")",
			"++y",
			"if (getBlockState(0, y, 0) ==. 'minecraft:pale_hanging_moss[tip=false]':",
				"setBlockState(0, y, 0, 'minecraft:pale_hanging_moss[tip=true]')",
			")",
			"return(true)"
		]
	}
}