		"decorations": {
			"trunk": [
				{ "type": "bigglobe:random_walk_leaves", "is_trunk": true }
			],
			"branches": [
				{ "type": "bigglobe:random_walk_leaves", "is_trunk": false }
			],
			"leaves": [
				{ "type": "bigglobe:feature", "feature": "bigglobe:nether/foliage/pale_hanging_moss_leaves" }
