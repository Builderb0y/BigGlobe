{
	"type": "bigglobe:script",
	"config": {
		"script": [
			"if (int*(y := world_traits.`bigglobe:lava_y`).isBetween[minValidYLevel, maxValidYLevel):",
				"placeFeature(originX, y, originZ, 'bigglobe:nether/decorators/lava_normal')",
			")",
			"if (hints.decorate:",
				"placeFeature(originX, 0, originZ, 'bigglobe:nether/ores/ancient_debris_at_random_y_level')",
				"placeFeature(originX, 0, originZ, 'bigglobe:nether/ores/ancient_debris_under_lava')",
			")",
			"for (int baseY in range[minValidYLevel, maxValidYLevel) % 32:",
				"int y = baseY | (worldSeed # 16x5EBDEDC4EE513888UL).newSeed(placementX, placementZ, baseY).nextInt(32)",
				"BlockState originState = getBlockState(originX, y, originZ)",
				"if (originState.isAir():",
					"if (getBlockState(originX, y - 1, originZ) ==. 'bigglobe:pale_netherrack':",
						"random.if (1.0I / 64.0I:",
							"placeFeature(originX, y, originZ, 'bigglobe:nether/flowers/eyeblossoms')",
						")",
						"unless (",
							"placeFeature(originX, y, originZ,",
								"random.if (0.125I:",
									"random.if (0.25I: 'bigglobe:nether/huge_eyeblossom')",
									"else ('bigglobe:nether/trees/natural/pale_oak_stump')",
								")",
								"else ('bigglobe:nether/trees/natural/pale_oak')",
							")",
						":",
							"random.if (0.25I: placeBlockState(originX, y, originZ, 'bigglobe:stick[waterlogged=false]'))",
						")",
						"repeat (4:",
							"int x = originX + random.nextInt(-6, 7)",
							"int z = originZ + random.nextInt(-6, 7)",
							"random.if (",
								"random.if (",
									"placeBlockState(x, y, z, 'minecraft:tall_grass[half=lower]')",
								")",
								"else (",
									"placeBlockState(x, y, z, 'minecraft:grass')",
								")",
							")",
							"else (",
								"placeBlockState(x, y, z, 'bigglobe:short_grass')",
							")",
						")",
					")",
					"else if (getBlockState(originX, y + 1, originZ).isIn('#minecraft:base_stone_nether'):",
						"random.if (1.0I / 16.0I: placeFeature(originX, y, originZ, 'bigglobe:nether/glowstone/normal'))",
						"placeFeature(originX, y, originZ, 'bigglobe:nether/foliage/pale_hanging_moss_cluster')",
					")",
				")",
				"else if (hints.decorate && originState.isIn('#minecraft:base_stone_nether'):",
					"placeFeature(originX, y, originZ, 'bigglobe:nether/random_sized_magma_in_netherrack_nospill')",
				")",
			")",
			"true"
		]
	}
}