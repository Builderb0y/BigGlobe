{
	"type": "bigglobe:script",
	"config": {
		"script": [
			"unless (getBlockState(0, 0, 0).isReplaceable(): return(false))",
			"int canOrient(int deltaY:",
				"for (int y in range(1, 8]:",
					"BlockState state = getBlockState(0, y * deltaY, 0)",
					"unless (state.isReplaceable():",
						"return(state.getBlock() ==. 'minecraft:moss_block' ? y : 16x7FFF_FFFFI)",
					")",
				")",
				"return(16x7FFF_FFFFI)",
			")",
			"int distanceAbove = canOrient(1)",
			"int distanceBelow = canOrient(-1)",
			"boolean upsideDown = compare (distanceAbove, distanceBelow:",
				"case (>: false)",
				"case (<: true)",
				"case (=: distanceAbove < 16x7FFF_FFFFI ? random.nextBoolean() : abort())",
			")",
			"void setReplaceable(int*(x, y, z), BlockState state:",
				"if (state != null && !setBlockStateReplaceable(x, y, z, state):",
					"abort()",
				")",
			")",
			"boolean brown = random.nextBoolean()",
			"BlockState stem = 'minecraft:mushroom_stem[up=false,down=false,north=true,south=true,east=true,west=true]'",
			"for (int y in range(0, upsideDown ? distanceAbove : distanceBelow):",
				"setBlockState(0, upsideDown ? y : -y, 0, stem)",
			")",
			"float*(",
				"horizontalRadius = random.nextBetween[brown ? 3.5I : 2.5I, 5.5I)",
				"verticalRadius = brown ? 2.5I : random.nextBetween[2.5I, 5.5I)",
				"rcpHorizontalRadius2 = 1.0I / horizontalRadius ^ 2",
				"rcpVerticalRadius2 = 1.0I / verticalRadius ^ 2",
			")",
			"boolean inside(int*(x, y, z):",
				"(x^2 + z^2) * rcpHorizontalRadius2 + y^2 * rcpVerticalRadius2 < 1.0I",
			")",
			"int emptyLayers = 0",
			"for (int offsetY in -range[0, floorInt(verticalRadius)]:",
				"boolean layerEmpty = false",
				"for (int*(x, z) in range[-floorInt(horizontalRadius), +floorInt(horizontalRadius)]:",
					"if (inside(x, offsetY, z):",
						"int y = upsideDown ? -offsetY : offsetY",
						"boolean*(",
							"px = !inside(x + 1, y, z)",
							"nx = !inside(x - 1, y, z)",
							"py = !inside(x, y + 1, z)",
							"ny = !inside(x, y - 1, z)",
							"pz = !inside(x, y, z + 1)",
							"nz = !inside(x, y, z - 1)",
							"anyOutside = px | py | pz | nx | ny | nz",
						")",
						"setReplaceable(x, y, z,",
							"if (anyOutside:",
								"BlockState(",
									"brown",
									"? 'minecraft:brown_mushroom_block'",
									": 'minecraft:red_mushroom_block',",
									"up: py || (upsideDown && y == 0),",
									"down: ny || (!upsideDown && y == 0),",
									"north: nz,",
									"south: pz,",
									"east: px,",
									"west: nx",
								")",
							")",
							"else if (x | z == 0:",
								"stem",
							")",
							"else if (upsideDown:",
								"layerEmpty = true",
								"switch (emptyLayers:",
									"case (0: 'minecraft:shroomlight')",
									"case (1: 'minecraft:water[level=0]')",
									"default (null)",
								")",
							")",
							"else (",
								"null",
							")",
						")",
					")",
				")",
				"emptyLayers += int(layerEmpty)",
			")",
			"return(true)"
		],
		"queue": "basic"
	}
}