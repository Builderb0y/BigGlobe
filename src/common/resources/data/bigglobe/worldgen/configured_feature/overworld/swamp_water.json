{
	"type": "bigglobe:script",
	"config": {
		"script": [
			"SmallPoolGenerator pool = new().=$groundReplaceable('#minecraft:substrate_overworld')",
			"pool.spread(world, 0, 0, 0).if (",
				"for (ColumnPos pos in pool.surroundingColumns:",
					"setBlockState(pos.x, -1, pos.z, 'minecraft:mud')",
					"setBlockState(pos.x,  0, pos.z, 'minecraft:mud')",
					"if (random.nextInt(16) == 0:",
						"placeFeature(pos.x, 1, pos.z, 'bigglobe:overworld/sugar_cane')",
					")",
				")",
				"for (ColumnPos pos in pool.fluidColumns:",
					"setBlockState(pos.x, -1, pos.z, 'minecraft:mud')",
					"setBlockState(pos.x,  0, pos.z, 'minecraft:water[level=0]')",
					"setBlockState(pos.x,  1, pos.z, random.nextInt(16) == 0 ? 'minecraft:lily_pad' : 'minecraft:air')",
					"if (getBlockState(pos.x, 2, pos.z).half != null:",
						"setBlockState(pos.x, 2, pos.z, 'minecraft:air')",
					")",
				")",
			")"
		]
	}
}