{
	"type": "bigglobe:script",
	"config": {
		"script": [
			"int y = 0",
			"block (",
				"unless (isYLevelValid(y): return(false))",
				"if (BlockState*(state := getBlockState(0, y, 0)).getBlock() ==. 'bigglobe:rock':",
					"int rocks = state.rocks.as(int) + 1",
					"return((rocks <= 6).if (",
						"setBlockState(0, y, 0, state.with('rocks', rocks))",
					"))",
				")",
				"if (getBlockState(0, y - 1, 0).isReplaceable(): --y,, continue())",
			")",
			"unless (BlockState*(state := getBlockState(0, y, 0)).getBlock() ==. 'minecraft:snow' || state.hasLava():",
				"return(placeBlockState(0, y, 0, 'bigglobe:rock[rocks=1,waterlogged=false]'))",
			")",
			"return(false)"
		]
	}
}