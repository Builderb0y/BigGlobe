{
	"type": "bigglobe:script",
	"config": {
		"script": {
			"debug_name": "ConfiguredFeatureOverworldSurfaceSmallFoliage",
			"source": [
				";handle cave intersecting surface.",
				"int y = 0",
				"block (",
					"unless (isYLevelValid(y): return(false))",
					"else if (getBlockState(0, y - 1, 0).isReplaceable(): --y,, continue())",
				")",

				"double adjustedFoliage = world_traits.`bigglobe:foliage_at_surface`",
				"adjustedFoliage /= sqrt(adjustedFoliage ^ 2 + 1.0)",
				"adjustedFoliage = adjustedFoliage * 0.5L + 0.5L",
				"random.unless(adjustedFoliage: return(false))",

				"BlockState existingState = getBlockState(0, y, 0)",
				"BlockState newState = null",
				"if (existingState ==. 'minecraft:air':",
					"BlockState below = getBlockState(0, y - 1, 0)",
					"if (below ==. 'minecraft:mud':",
						"return(false)",
					")",
					"else if (below ==. 'minecraft:blackstone': ;island volcanoes",
						"newState = 'bigglobe:charred_grass'",
					")",
					"else (",
						"double fromTemperate = world_traits.`bigglobe:temperature_at` ^ 2 + world_traits.`bigglobe:foliage_at` ^ 2",
						"double deadBushChance = fromTemperate / (fromTemperate * 8.0 + 4.0)",
						"float  fernChance = world_traits.`bigglobe:humidity_at` * 0.125I + 0.125I",
						"random.if (deadBushChance:",
							"random.unless (unmixSmooth(2.0L, 6.0L, y): return(false))",
							"newState = 'minecraft:dead_bush'",
						")",
						"else random.if (adjustedFoliage:",
							"random.if (adjustedFoliage:",
								"if (below.isIn('#minecraft:sand'):",
									"newState = random.nextBoolean(0.015625I) ? 'minecraft:tall_dry_grass' : null",
								")",
								"else (",
									"newState = random.nextBoolean(fernChance) ? 'minecraft:large_fern[half=lower]' : 'minecraft:tall_grass[half=lower]'",
								")",
							")",
							"else (",
								"if (below.isIn('#minecraft:sand'):",
									"newState = random.nextBoolean(0.015625I) ? 'minecraft:short_dry_grass' : null",
								")",
								"else (",
									"newState = random.nextBoolean(fernChance) ? 'minecraft:fern' : 'minecraft:grass'",
								")",
							")",
						")",
						"else (",
							"newState = 'bigglobe:short_grass'",
						")",
					")",
				")",
				"else if (existingState ==. 'minecraft:water[level=0]':",
					"random.if (adjustedFoliage:",
						"random.if (adjustedFoliage:",
							"newState = 'minecraft:tall_seagrass[half=lower]'",
						")",
						"else (",
							"newState = 'minecraft:seagrass'",
						")",
					")",
					"else (",
						"return(false) ;no short seagrass.",
					")",
				")",
				"else (",
					"return(false)",
				")",
				"return(newState != null && placeBlockState(0, y, 0, newState))"
			]
		}
	}
}