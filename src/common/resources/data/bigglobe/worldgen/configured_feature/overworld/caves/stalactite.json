{
	"type": "bigglobe:script",
	"config": {
		"script": [
			"unless (getBlockState(0, 0, 0).isReplaceable() && getBlockState(0, 1, 0) ==. 'minecraft:dripstone_block': return(false))",
			"int height = 0",
			"float chance = world_traits.`bigglobe:cave_surface_depth` * 0.125I",
			"do while (random.nextBoolean(chance) && getBlockState(0, -height, 0).isReplaceable():",
				"++height",
			")",
			"boolean connect = getBlockState(0, -height, 0).getBlock() ==. 'minecraft:pointed_dripstone'",
			"for (int offsetY in range[0, height):",
				"setBlockState(0, -offsetY, 0,",
					"BlockState(",
						"'minecraft:pointed_dripstone',",
						"vertical_direction: 'down',",
						"waterlogged: getBlockState(0, +offsetY, 0).hasWater(),",
						"thickness: (",
							"if (offsetY == height - 1:",
								"connect ? 'tip_merge' : 'tip'",
							")",
							"else if (offsetY == height - 2: 'frustum')",
							"else if (offsetY == 0: 'base')",
							"else ('middle')",
						")",
					")",
				")",
			")",
			"if (connect:",
				"setBlockState(0, -height, 0, BlockState('minecraft:pointed_dripstone', vertical_direction: 'up', thickness: 'tip_merge', waterlogged: getBlockState(0, -height, 0).hasWater()))",
			")",
			"return(true)"
		]
	}
}