{
	"type": "bigglobe:script",
	"config": {
		"script": [
			"if (getBlockState(0, -1, 0).isAir():",
				"int*(logX = 0, logZ = 0)",
				"String orientation = random.switch (",
					"(++logX,, 'west'),",
					"(--logX,, 'east'),",
					"(++logZ,, 'north'),",
					"(--logZ,, 'south')",
				")",
				"if (getBlockState(logX, -1, logZ).isIn('#minecraft:logs_that_burn'):",
					"setBlockState(0, -1, 0, BlockState(",
						"'minecraft:bee_nest',",
						"facing:      orientation,",
						"honey_level: random.nextInt(6)",
					"))",
					"NbtList list = nbtList()",
					"if (MinecraftVersion.CURRENT >=. '1.20.5':",
						"repeat (random.nextInt(2, 4):",
							"list.add(",
								"nbtCompound(",
									"entity_data: nbtCompound(id: 'minecraft:bee'),",
									"ticks_in_hive: random.nextInt(599),",
									"min_ticks_in_hive: 600",
								")",
							")",
						")",
						"mergeBlockData(0, -1, 0, nbtCompound(bees: list))",
					")",
					"else (",
						"repeat (random.nextInt(2, 4):",
							"list.add(",
								"nbtCompound(",
									"EntityData: nbtCompound(id: 'minecraft:bee'),",
									"TicksInHive: random.nextInt(599),",
									"MinOccupationTicks: 600",
								")",
							")",
						")",
						"mergeBlockData(0, -1, 0, nbtCompound(Bees: list))",
					")",
					"return(true)",
				")",
			")",
			"return(false)"
		]
	}
}