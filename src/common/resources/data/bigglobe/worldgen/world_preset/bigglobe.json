{
	"dimensions": {
		"minecraft:overworld": {
			"type": "bigglobe:overworld",
			"generator": {
				"type": "bigglobe:scripted",
				"reload_dimension": "minecraft:overworld",
				"height": {
					"min_y": -1024,
					"max_y":  1024,
					"sea_level": 0
				},
				"world_traits": "bigglobe:overworld",
				"layer": "bigglobe:overworld/root",
				"feature_dispatcher": {
					"rock_replacers": [
						"bigglobe:overworld/bedrock",
						"bigglobe:overworld/cobblestone_sprinkle",
						"#bigglobe:overworld/ores"
					],
					"raw": "bigglobe:overworld/raw_root",
					"normal": "bigglobe:overworld/normal_root"
				},
				"biome_source": {
					"type": "bigglobe:scripted",
					"script": "`bigglobe:overworld/biome`",
					"all_possible_biomes": "#bigglobe:overworld_except_volcano"
				},
				"overriders": "#bigglobe:overworld",
				"game_mechanics": {
					"spawn_point": {
						"file": "bigglobe:world_preset/overworld_spawn_point"
					},
					"mob_spawn_tweakers": "#bigglobe:overworld",
					"colors": {
						"grass": {
							"source": "computeBiomeTint(false, 0.0I)",
							"includes": "bigglobe:include/biome_tint"
						},
						"foliage": {
							"source": "computeBiomeTint(true, 0.0I)",
							"includes": "bigglobe:include/biome_tint"
						},
						"water": [
							"float temperature = world_traits.`bigglobe:temperature_at` * 4.0I",
							"temperature /= sqrt(temperature ^ 2 + 1.0I).as(float)",
							"packI(63, roundInt(temperature * 64.0I + 128.0I), 255)"
						]
					},
					"grass_bonemeal_feature": "bigglobe:overworld/grass_bonemeal",
					"sound_modifier": {
						"file": "bigglobe:world_preset/overworld_sound_modifier"
					}
				}
			}
		},



		"minecraft:the_nether": {
