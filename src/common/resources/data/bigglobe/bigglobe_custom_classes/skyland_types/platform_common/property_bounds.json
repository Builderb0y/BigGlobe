{
	"element_type": "property/normal",
	"name": "bounds",
	"property_type": "bigglobe:skyland_bounds/class",
	"get": [
		"double actualExclusion = 1.0L - (center_column.`bigglobe:overworld/skylands/exclusion` + center_column.`bigglobe:overworld/skyland`.soft_distance_squared * 1.25L)",
		"if (actualExclusion !> 0.0L: return(null))",
		"long seed = (worldSeed # 16x9E16B3F642DFC38FUL).newSeed(cell_x, cell_z)",
		"double averageCenter = seed.nextDouble(-256.0L, +256.0L) * actualExclusion + 512.0L",
		"double top = averageCenter + plains_center",
		"double outness = soft_distance / actualExclusion",
		"if (outness !<= 1.0L: return(null))",
		"double curve = actualExclusion * seed.newSeed().nextDouble(32.0L, 64.0L) * (outness - 1.0L) / (outness * 2.0L + 1.0L)",
		"SkylandBounds.new(top + curve, top)"
	]
}